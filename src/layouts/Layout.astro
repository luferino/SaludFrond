---
import { getSession } from '../shared/session';
import { decodeJwt, isTokenValid } from '../shared/jwt';

const token = getSession(Astro.cookies);
const isLoggedIn = token !== null && isTokenValid(token);
const payload = token ? decodeJwt(token) : null;
const isAdmin = payload?.role === 'admin';
// Presentation hint only; the backend checks current permissions on each request.
const canRegister = isLoggedIn && Array.isArray(payload?.permissions)
	&& payload.permissions.every((permission) => typeof permission === 'string')
	&& payload.permissions.includes('users:write');
const currentPath = Astro.url?.pathname.replace(/\/$/, '') || '/';
const pageTitles: Record<string, string> = {
	'/': 'Inicio', '/students': 'Estudiantes', '/teachers': 'Profesores',
	'/patients': 'Pacientes', '/auth/register': 'Registrar usuario',
	'/auth/login': 'Iniciar sesión', '/auth/forgot-password': 'Recuperar contraseña',
	'/auth/reset-password': 'Restablecer contraseña',
};
const pageTitle = pageTitles[currentPath] ?? 'Salud';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle} · Salud</title>
	</head>
	<body>
		<a class="skip-link" href="#page-content">Saltar al contenido</a>
		<div class:list={['shell', { 'is-authenticated': isLoggedIn }]}>
			<aside class="sidebar" aria-label="Navegación de Salud">
				<a class="brand" href={isLoggedIn ? '/' : '/auth/login'} aria-label="Salud, inicio">
					<span class="brand-mark" aria-hidden="true">+</span>
					<span>Salud<small>Sistema de gestión</small></span>
				</a>
				{isLoggedIn ? (
					<>
						<p class="nav-label">Tu espacio de trabajo</p>
						<nav class="module-nav" aria-label="Principal">
							<a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Inicio <span aria-hidden="true">↗</span></a>
							{isAdmin && <a href="/students" aria-current={currentPath === '/students' ? 'page' : undefined}>Estudiantes <span aria-hidden="true">↗</span></a>}
							{isAdmin && <a href="/teachers" aria-current={currentPath === '/teachers' ? 'page' : undefined}>Profesores <span aria-hidden="true">↗</span></a>}
							{isAdmin && <a href="/patients" aria-current={currentPath === '/patients' ? 'page' : undefined}>Pacientes <span aria-hidden="true">↗</span></a>}
						</nav>
						<nav class="account-nav" aria-label="Cuenta">
							{canRegister && <a href="/auth/register">Registrar usuario</a>}
							<a href="/logout">Salir <span aria-hidden="true">↗</span></a>
						</nav>
						<p class="sidebar-note">Un espacio para acompañar<br />y cuidar a las personas.</p>
					</>
				) : (
					<nav class="account-nav" aria-label="Acceso">
						<a href="/auth/login">Iniciar Sesión</a>
					</nav>
				)}
			</aside>
			<div class="workspace">
				<header class="workspace-header">
					<div>
						<p class="eyebrow">Sistema de salud / {pageTitle}</p>
						<p class="page-title">{currentPath === '/' ? 'Bienvenido a Salud' : pageTitle}</p>
					</div>
					{isLoggedIn && <span class="session-badge">Sesión activa</span>}
				</header>
				<div id="page-content" class="page-content" tabindex="-1">
					<slot />
				</div>
			</div>
		</div>
	</body>
</html>

<style>
	:global(:root) {
		--ink: #282c28;
		--muted: #656258;
		--paper: #f8f3e9;
		--canvas: #e8e0d1;
		--line: #cfc3af;
		--rust: #a84d34;
		--rust-deep: #843b28;
		--rust-soft: #fae8df;
		--rust-line: #b97560;
		--sage: #bac3b0;
		--sage-soft: #e5eadf;
		--sage-deep: #656f59;
		--field: #fffdf8;
		--field-line: #a49985;
		--serif: Georgia, 'Times New Roman', serif;
	}
	:global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
	:global(:focus-visible) { outline: 3px solid var(--rust); outline-offset: 4px; }
	html, body {
		margin: 0;
		min-height: 100%;
		background: var(--canvas);
		color: var(--ink);
		font: 0.9375rem/1.6 'Segoe UI', Arial, sans-serif;
	}
	.shell { min-height: 100vh; }
	.is-authenticated { display: grid; grid-template-columns: 260px minmax(0, 1fr); }
	a { color: inherit; text-decoration: none; }
	.skip-link {
		position: absolute;
		left: 1rem;
		top: -6rem;
		z-index: 5;
		padding: 0.75rem 1rem;
		background: var(--paper);
	}
	.skip-link:focus { top: 1rem; }
	.sidebar { display: flex; flex-direction: column; background: var(--ink); color: var(--paper); }
	.brand {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 1.6rem;
		background: var(--paper);
		color: var(--ink);
		font: 2.1rem/1.1 var(--serif);
		border-bottom: 1px solid var(--line);
	}
	.brand-mark { color: var(--rust); font: 3rem/1 Georgia, serif; }
	.brand small { display: block; margin-top: 0.45rem; font: 0.7rem/1.4 'Segoe UI', Arial, sans-serif; }
	.nav-label, .eyebrow { font: 0.65rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	.nav-label { margin: 2rem 1.5rem 1.4rem; color: #d3cdbe; }
	.module-nav { display: grid; gap: 1.5rem; padding: 0 1.25rem 2rem; }
	.module-nav a {
		--folder: #e6d8bb;
		position: relative;
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1rem;
		border-radius: 0 8px 8px 8px;
		background: var(--folder);
		color: var(--ink);
		font-weight: 600;
	}
	.module-nav a::before {
		content: '';
		position: absolute;
		top: -9px;
		left: 0;
		width: 40%;
		height: 10px;
		border-radius: 6px 6px 0 0;
		background: var(--folder);
	}
	.module-nav a:nth-child(2) { --folder: #edcdbb; }
	.module-nav a:nth-child(3) { --folder: #ccd5c4; }
	.module-nav a[aria-current='page'] { box-shadow: inset 4px 0 var(--rust); }
	.module-nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
	.sidebar :focus-visible { outline-color: #edcdbb; }
	.sidebar .brand:focus-visible { outline-color: var(--rust); outline-offset: -5px; }
	.account-nav { display: grid; gap: 0.25rem; padding: 1rem 1.5rem; border-top: 1px solid #53584e; }
	.account-nav a { padding: 0.5rem 0; text-decoration: underline; text-underline-offset: 4px; }
	.sidebar-note { margin: auto 1.5rem 0; padding: 2rem 0; color: #d3cdbe; font: italic 1rem/1.6 var(--serif); }
	.workspace { min-width: 0; }
	.workspace-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		padding: 1.6rem clamp(1.25rem, 3vw, 3rem);
		background: var(--paper);
		border-bottom: 1px solid var(--line);
	}
	.eyebrow { margin: 0 0 0.4rem; color: var(--muted); }
	.page-title { margin: 0; font: 1.9rem/1.2 var(--serif); }
	.session-badge { padding: 0.35rem 0.7rem; border: 1px solid var(--sage); border-radius: 20px; background: var(--sage-soft); font-size: 0.75rem; }
	.page-content { padding: clamp(1.25rem, 3vw, 3rem); overflow-wrap: anywhere; }
	@media (max-width: 760px) {
		.is-authenticated { grid-template-columns: minmax(0, 1fr); }
		.brand { padding: 1rem 1.25rem; }
		.nav-label { margin: 1rem 1.25rem; }
		.module-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 0.75rem; padding-bottom: 1rem; }
		.module-nav a { padding: 0.8rem; font-size: 0.875rem; }
		.account-nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding: 0.65rem 1.25rem; }
		.sidebar-note { display: none; }
		.workspace-header { padding: 1.25rem; }
	}
</style>
