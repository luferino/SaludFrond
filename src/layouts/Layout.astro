---
import { getSession } from '../shared/session';
import { decodeJwt } from '../shared/jwt';

const token = getSession(Astro.cookies);
const isLoggedIn = token !== null;
const payload = token ? decodeJwt(token) : null;
const isAdmin = payload?.role === 'admin';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Salud Frontend</title>
	</head>
	<body>
		{isLoggedIn ? (
			<header>
				<nav>
					{isAdmin && <a href="/students">Estudiantes</a>}
					{isAdmin && <a href="/teachers">Profesores</a>}
					{isAdmin && <a href="/patients">Pacientes</a>}
					<a href="/logout">Salir</a>
				</nav>
			</header>
		) : (
			<header>
				<nav>
					<a href="/auth/login">Iniciar Sesión</a>
					<a href="/auth/register">Registrarse</a>
				</nav>
			</header>
		)}
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
