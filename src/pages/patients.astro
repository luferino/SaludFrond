---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PatientForm from '../pods/paciente/components/form-paciente.astro';
import { getSession } from '../shared/session';
import { decodeJwt } from '../shared/jwt';

const token = getSession(Astro.cookies);
const payload = token ? decodeJwt(token) : null;

if (!payload || payload.role !== 'admin') {
	return Astro.redirect('/auth/login');
}
---

<Layout>
	<main aria-labelledby="patient-title">
		<header class="intro">
			<p class="eyebrow">Atención / Pacientes</p>
			<h1 id="patient-title">Registrar paciente</h1>
			<p>Completa los datos personales y de contacto para dar de alta al paciente.</p>
		</header>
		<PatientForm />
	</main>
</Layout>

<style>
	main { max-width: 1040px; min-width: 0; margin: 0 auto; }
	.intro { margin-bottom: 2rem; }
	.intro p { margin: 0.75rem 0; color: var(--muted); }
	.eyebrow { font: 0.65rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	h1 {
		margin: 0.5rem 0;
		font: 400 clamp(2rem, 3vw, 2.75rem)/1.15 var(--serif);
	}
</style>
