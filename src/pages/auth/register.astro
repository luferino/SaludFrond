---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import RegisterForm from '../../pods/auth/components/RegisterForm.astro';
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.register);

if (result?.data?.redirectTo) {
	return Astro.redirect(result.data.redirectTo, 303);
}
---

<Layout>
	<main aria-labelledby="register-title">
		<header class="intro">
			<p class="eyebrow">Acceso al sistema / Usuarios</p>
			<h1 id="register-title">Registrar usuario</h1>
			<p>Completa los datos de la nueva cuenta sin cerrar tu sesión actual.</p>
		</header>
		<RegisterForm />
	</main>
</Layout>

<style>
	main { max-width: 1040px; min-width: 0; margin: 0 auto; }
	.intro { margin-bottom: 2rem; }
	.intro p { margin: 0.75rem 0; color: var(--muted); }
	.eyebrow { font: 0.65rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	h1 {
		margin: 0.5rem 0;
		font: 400 clamp(2rem, 3vw, 2.75rem)/1.15 var(--serif);
	}
</style>
