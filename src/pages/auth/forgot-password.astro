---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ForgotPasswordForm from '../../pods/auth/components/ForgotPasswordForm.astro';
---

<Layout>
	<main>
		<h1>Recuperar contraseña</h1>
		<p class="subtitle">Ingresá tu usuario y te enviaremos un enlace para restablecer tu contraseña.</p>
		<ForgotPasswordForm />
	</main>
</Layout>

<style>
	main {
		padding-top: 4rem;
	}

	h1 {
		text-align: center;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		text-align: center;
		color: #6b7280;
		font-size: 0.875rem;
		margin-bottom: 1.5rem;
	}
</style>
