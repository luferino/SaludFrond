---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import LoginForm from '../../pods/auth/components/LoginForm.astro';
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.login);

if (result?.data?.returnTo) {
	return Astro.redirect(result.data.returnTo);
}
---

<Layout>
	<main>
		<h1>Iniciar Sesión</h1>
		<LoginForm />
	</main>
</Layout>

<style>
	main {
		padding-top: 4rem;
	}

	h1 {
		text-align: center;
		margin-bottom: 1.5rem;
	}
</style>
