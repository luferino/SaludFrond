---
export const prerender = false;
import { actions, isInputError } from 'astro:actions';
import Layout from '../../layouts/Layout.astro';
import SubmissionSnapshot from '../../components/clinical/SubmissionSnapshot.astro';
import { ApiError } from '../../shared/apiClient';
import { listAssignedPatients, parseAssignmentPagination } from '../../pods/patient-assignment/api';
import { actionHrefWithContext, antecedentOptionState, EVALUATION_STATUS_LABELS, getEvaluation, listCorrections, listSubmissions, type CorrectionEvent, type Evaluation, type EvaluationContent, type Submission } from '../../pods/kinesiology-evaluation/api';
import { rawEvaluationContentFromForm } from '../../pods/kinesiology-evaluation/actions/evaluations';
import { decodeJwt } from '../../shared/jwt';

const id = Astro.params.id ?? '';
const search = Astro.url.searchParams;
const assignmentParams = search.getAll('assignment_id');
const assignmentId = assignmentParams.length === 1 ? assignmentParams[0] : '';
let limit = 50;
let offset = 0;
let evaluation: Evaluation | null = null;
let patientLabel = '';
let eligible = false;
let canSubmit = false;
let unavailable = false;
let loadError = '';
let submissions: Submission[] = [];
let historyError = '';
let corrections: CorrectionEvent[] = [];
let correctionsError = '';
let correctionsLoaded = false;
let correctionDraft = false;
let crossContext = false;
let canAmend = false;
const result = Astro.getActionResult(actions.updateKinesiologyEvaluation);
let retainedContent: EvaluationContent | undefined = result?.data?.success === false ? result.data.content : undefined;
let errorText = result?.data?.success === false ? result.data.error : '';
if (result?.error) {
	errorText = isInputError(result.error) ? 'Revisá los campos del formulario. Conservamos los valores enviados.' : result.error.message;
	if (isInputError(result.error)) {
		try {
			const submitted = Object.fromEntries((await Astro.request.clone().formData()).entries());
			retainedContent = rawEvaluationContentFromForm(submitted);
		} catch { /* Some framework validation failures do not expose the submitted form body. */ }
	}
}
const submitResult = Astro.getActionResult(actions.submitKinesiologyEvaluation);
const submitData = submitResult?.data;
if (submitData?.success) {
	// Redirect from the context the action validated, before any fallible read.
	const returnParams = new URLSearchParams({ assignment_id: submitData.assignment_id, limit: submitData.limit, offset: submitData.offset, submitted: '1' });
	return Astro.redirect(`/kinesiology-evaluations/${encodeURIComponent(submitData.id)}?${returnParams}`);
}
const submitUncertain = submitData?.success === false && submitData.uncertain || !!submitResult?.error && !isInputError(submitResult.error);
const submitError = submitUncertain && submitResult?.error
	? 'No se pudo confirmar el envío. Consultá el estado de la ficha antes de volver a intentarlo.'
	: submitData?.success === false ? submitData.error : submitResult?.error ? 'Revisá los datos del envío.' : '';
const amendResult = Astro.getActionResult(actions.createKinesiologyAmendment);
const amendData = amendResult?.data;
if (amendData?.success) {
	// Open the new draft through the context the action validated.
	const returnParams = new URLSearchParams({ assignment_id: amendData.assignment_id, limit: amendData.limit, offset: amendData.offset, amended: '1' });
	return Astro.redirect(`/kinesiology-evaluations/${encodeURIComponent(amendData.id)}?${returnParams}`);
}
const amendUncertain = amendData?.success === false && amendData.uncertain || !!amendResult?.error && !isInputError(amendResult.error);
const amendError = amendUncertain && amendResult?.error
	? 'No se pudo confirmar la creación de la enmienda. Revisá los borradores de la asignación antes de volver a intentarlo: cada intento puede crear una enmienda nueva.'
	: amendData?.success === false ? amendData.error : amendResult?.error ? 'Confirmá que querés crear una enmienda nueva.' : '';
if (/sesión venció/i.test(errorText) || /sesión venció/i.test(submitError) || /sesión venció/i.test(amendError)) {
	return Astro.redirect(`/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
}
try {
	const pagination = parseAssignmentPagination(search);
	limit = pagination.limit;
	offset = pagination.offset;
	if (!/^[1-9]\d{0,18}$/.test(assignmentId) || BigInt(assignmentId) > 9223372036854775807n
		|| !/^[1-9]\d{0,18}$/.test(id) || BigInt(id) > 9223372036854775807n) {
		unavailable = true;
	} else {
		const page = await listAssignedPatients(pagination, Astro.cookies);
		const assignment = page.items.find((item) => item.id === assignmentId && item.ended_at === null);
		if (!assignment) unavailable = true;
		else {
			const record = await getEvaluation(id, Astro.cookies);
			const sameContext = record.origin_subject_id === assignment.subject_id && record.origin_group_id === assignment.academic_group_id;
			// Another origin is readable only as a submitted snapshot; a draft from another origin never renders.
			if (record.id !== id || record.patient_id !== assignment.patient_id || (!sameContext && record.status === 'draft')) {
				unavailable = true;
			} else {
				evaluation = record;
				crossContext = !sameContext;
				patientLabel = record.patient
					? `${record.patient.apellidos}, ${record.patient.nombres} · ${record.patient.documento}`
					: 'Datos del paciente no disponibles';
				const token = Astro.cookies.get('session')?.value;
				const actor = token ? decodeJwt(token) : null;
				const role = actor?.role === 'student' || actor?.role === 'estudiante';
				const canWrite = Array.isArray(actor?.permissions)
					&& actor.permissions.includes('kinesiology-evaluations:write');
				eligible = !crossContext && record.status === 'draft' && actor?.sub === record.author_id && role && canWrite;
				// Any student with write access in the origin context may amend; the backend rechecks habilitation and assignment.
				canAmend = !crossContext && record.status === 'validated' && role && canWrite && !amendUncertain;
				const originAuthor = !crossContext && role && actor?.sub === record.author_id;
				// Correction reasons and working content stay with the original author in the verified assignment context.
				if (originAuthor) {
					try {
						corrections = (await listCorrections(id, Astro.cookies)).items;
						correctionsLoaded = true;
					} catch (correctionFailure) {
						if (correctionFailure instanceof ApiError && correctionFailure.status === 401) throw correctionFailure;
						correctionsError = 'No se pudieron cargar las solicitudes de corrección. La ficha se muestra igual; intentá recargar la página.';
					}
				}
				correctionDraft = record.status === 'draft' && originAuthor && correctionsLoaded && corrections.length > 0;
				// Retained values are unsaved; submission only sends the saved version. A failed correction read cannot make a draft actionable.
				canSubmit = eligible && !retainedContent && correctionsLoaded && Array.isArray(actor?.permissions)
					&& actor.permissions.includes('kinesiology-evaluations:submit');
				// Version history is read-only and loads only after the identity checks above; a failure never hides the record.
				if (record.status !== 'draft' || correctionDraft) {
					try { submissions = (await listSubmissions(id, Astro.cookies)).items; }
					catch (historyFailure) {
						if (historyFailure instanceof ApiError && historyFailure.status === 401) throw historyFailure;
						historyError = 'No se pudo cargar el historial de versiones. La ficha se muestra igual; intentá recargar la página.';
					}
				}
			}
		}
	}
} catch (error) {
	if (error instanceof ApiError && error.status === 401) {
		return Astro.redirect(`/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
	}
	loadError = 'No se pudo verificar esta ficha. Volvé a la lista antes de intentar otra acción.';
}
if (result?.data?.success && evaluation) {
	return Astro.redirect(`/kinesiology-evaluations/${id}?assignment_id=${encodeURIComponent(assignmentId)}&limit=${limit}&offset=${offset}&saved=1`);
}
const contextHref = `/my-patients/${encodeURIComponent(assignmentId)}?limit=${limit}&offset=${offset}`;
const actionHref = actionHrefWithContext(actions.updateKinesiologyEvaluation.toString(), {
	assignment_id: assignmentId,
	limit: String(limit),
	offset: String(offset),
}, Astro.url.href);
const submitHref = actionHrefWithContext(actions.submitKinesiologyEvaluation.toString(), {
	assignment_id: assignmentId,
	limit: String(limit),
	offset: String(offset),
}, Astro.url.href);
const c = retainedContent ?? evaluation?.content ?? {};
const antecedents = c.antecedents ?? {};
const antecedentKeys = Object.keys(antecedents).join(',');
const saved = search.getAll('saved').length === 1 && search.get('saved') === '1';
const justSubmitted = search.getAll('submitted').length === 1 && search.get('submitted') === '1';
const justAmended = search.getAll('amended').length === 1 && search.get('amended') === '1';
const amendHref = actionHrefWithContext(actions.createKinesiologyAmendment.toString(), {
	assignment_id: assignmentId,
	limit: String(limit),
	offset: String(offset),
}, Astro.url.href);
const amendmentOfHref = evaluation?.amendment_of_evaluation_id
	? `/kinesiology-evaluations/${encodeURIComponent(evaluation.amendment_of_evaluation_id)}?assignment_id=${encodeURIComponent(assignmentId)}&limit=${limit}&offset=${offset}`
	: '';
const textFields = [
	['admission_status', 'Estado al ingreso'], ['occupation', 'Ocupación'],
	['referring_physician', 'Profesional que deriva'], ['illness_history', 'Historia de la enfermedad'],
	['medical_diagnosis', 'Diagnóstico médico'], ['kinesiology_diagnosis', 'Diagnóstico kinésico'],
	['objectives', 'Objetivos'], ['proposed_treatment', 'Tratamiento propuesto'],
] as const;
---
<Layout>
	<main class="clinical-page" aria-labelledby="title">
		<p class="eyebrow"><a href={contextHref}>Volver a la ficha kinésica inicial</a></p>
		{unavailable ? <section class="notice" role="status">
			<h1 id="title">Ficha no disponible</h1>
			<p>No se pudo confirmar que esta ficha pertenezca a la asignación seleccionada. Volvé a elegir el contexto vigente.</p>
			<a class="button secondary" href="/my-patients">Volver a mis pacientes</a>
		</section> : loadError ? <section class="notice error" role="alert">
			<h1 id="title">No se pudo cargar la ficha</h1>
			<p>{loadError}</p>
			<a href={contextHref}>Volver a la asignación</a>
		</section> : evaluation ? <>
			<header>
				<h1 id="title">Ficha kinésica inicial</h1>
				<p class="patient">Paciente: {patientLabel}</p>
				<p class="context">Asignatura · <span class="identifier">{evaluation.origin_subject_id}</span><br />Grupo académico · <span class="identifier">{evaluation.origin_group_id}</span></p>
			</header>
			<section class="status" aria-labelledby="status-title">
				<h2 id="status-title">Estado de la ficha</h2>
				<p>{EVALUATION_STATUS_LABELS[evaluation.status]}</p>
				{evaluation.status !== 'draft' && <p>La ficha fue enviada y ya no se puede editar. Queda disponible en la asignación, en la lista de fichas enviadas.</p>}
			</section>
			{saved && <p class="success" role="status">Borrador guardado.</p>}
			{evaluation.amendment_of_evaluation_id && <p class="notice">Esta ficha es una enmienda de la <a href={amendmentOfHref}>ficha validada {evaluation.amendment_of_evaluation_id}</a>. La ficha original no cambia.</p>}
			{justSubmitted && evaluation.status !== 'draft' && <p class="success" role="status">Ficha enviada. Queda pendiente de validación docente.</p>}
			{justAmended && evaluation.status === 'draft' && <p class="success" role="status">Enmienda creada. Editá y guardá el borrador; después envialo para una nueva revisión docente.</p>}
			{errorText && <p class="notice error" role="alert">{errorText}</p>}
			{submitError && <p class="notice error" role="alert">{submitError}</p>}
			{amendError && <p class="notice error" role="alert">{amendError}</p>}
			{correctionsError && <p class="notice error" role="alert">{correctionsError}</p>}
			{crossContext && <p class="notice">Esta ficha fue registrada en otra asignatura o grupo y se muestra en modo de solo lectura.</p>}
			{!eligible && !crossContext && <p class="notice">Esta ficha se muestra en modo de solo lectura. Solo el autor de un borrador en una asignación vigente puede editarla; el servicio vuelve a comprobar los permisos al guardar.</p>}
			{eligible && <p class="notice">Evitá editar este borrador al mismo tiempo que otra persona. El guardado reemplaza el contenido completo y no detecta cambios simultáneos.</p>}
			{!crossContext && <form method="POST" action={actionHref} id="evaluation-form">
				<input type="hidden" name="id" value={evaluation.id} />
				<input type="hidden" name="assignment_id" value={assignmentId} />
				<input type="hidden" name="limit" value={limit} />
				<input type="hidden" name="offset" value={offset} />
				<input type="hidden" name="antecedents_keys" value={antecedentKeys} />
				<fieldset disabled={!eligible}>
					<legend>Datos de admisión</legend>
					<label>Fecha de ingreso <input name="admission_date" type="date" value={c.admission_date ?? ''} /></label>
					<label>Estado al ingreso <textarea name="admission_status">{c.admission_status ?? ''}</textarea></label>
					<label>Ocupación <input name="occupation" value={c.occupation ?? ''} /></label>
					<label>Profesional que deriva <input name="referring_physician" value={c.referring_physician ?? ''} /></label>
				</fieldset>
				<fieldset disabled={!eligible}>
					<legend>Antecedentes clínicos</legend>
					{(['hta', 'dbt', 'diu', 'sedentary_lifestyle', 'pacemaker'] as const).map((key) => {
						const present = Object.hasOwn(antecedents, key);
						const value = antecedents[key];
						const selected = antecedentOptionState(value, present);
						const labels = { hta: 'Hipertensión arterial', dbt: 'Diabetes', diu: 'Dispositivo intrauterino', sedentary_lifestyle: 'Sedentarismo', pacemaker: 'Marcapasos' };
						return <label>{labels[key]} <select name={`antecedent-${key}`}>
							<option value="" selected={selected.unrecorded}>Sin registrar</option>
							<option value="unknown" selected={selected.unknown}>Sin determinar</option>
							<option value="true" selected={selected.yes}>Sí</option>
							<option value="false" selected={selected.no}>No</option>
						</select></label>;
					})}
					<label>Otros antecedentes <textarea name="antecedent-other">{antecedents.other ?? ''}</textarea></label>
				</fieldset>
				<fieldset disabled={!eligible}>
					<legend>Historia y evaluación</legend>
					{(['illness_history', 'medical_diagnosis', 'kinesiology_diagnosis', 'objectives', 'proposed_treatment'] as const).map((key) => {
						const labels = { illness_history: 'Historia de la enfermedad', medical_diagnosis: 'Diagnóstico médico', kinesiology_diagnosis: 'Diagnóstico kinésico', objectives: 'Objetivos', proposed_treatment: 'Tratamiento propuesto' };
						return <label>{labels[key]} <textarea name={key}>{c[key] ?? ''}</textarea></label>;
					})}
				</fieldset>
				<fieldset disabled={!eligible}>
					<legend>Estudios complementarios</legend>
					<div id="studies">
						{(c.studies ?? []).map((study, index) => <div class="study-row">
							<label>Tipo <input name={`study-type-${index}`} value={study.type} /></label>
							<label>Descripción <textarea name={`study-description-${index}`}>{study.description}</textarea></label>
							<label>Fecha <input name={`study-date-${index}`} type="date" value={study.date ?? ''} /></label>
							<button class="remove-study" type="button" aria-label="Quitar estudio">Quitar estudio</button>
						</div>)}
					</div>
					<button id="add-study" class="button secondary" type="button">Agregar estudio</button>
				</fieldset>
				{eligible && <button class="button" type="submit">Guardar borrador</button>}
			</form>}
			{canSubmit && !submitUncertain && <form method="POST" action={submitHref} id="submit-form" class="submit-panel">
				<input type="hidden" name="id" value={evaluation.id} />
				<input type="hidden" name="assignment_id" value={assignmentId} />
				<input type="hidden" name="limit" value={limit} />
				<input type="hidden" name="offset" value={offset} />
				<h2>{correctionDraft ? 'Reenviar versión guardada' : 'Enviar ficha'}</h2>
				<p>Se envía la última versión guardada del borrador. Los cambios sin guardar no se incluyen; guardalos antes de enviar. Después del envío la ficha ya no se puede editar.</p>
				<p id="dirty-notice" class="notice error" role="status" hidden>Hay cambios sin guardar. Guardá el borrador antes de enviarlo.</p>
				<button id="submit-button" class="button" type="submit">{correctionDraft ? 'Reenviar versión guardada' : 'Enviar ficha guardada'}</button>
				<button id="discard-button" class="button secondary" type="button" hidden>Descartar cambios</button>
			</form>}
			{canAmend && <form method="POST" action={amendHref} id="amend-form" class="submit-panel">
				<input type="hidden" name="id" value={evaluation.id} />
				<input type="hidden" name="assignment_id" value={assignmentId} />
				<input type="hidden" name="limit" value={limit} />
				<input type="hidden" name="offset" value={offset} />
				<h2>Crear enmienda</h2>
				<p>Se crea un borrador nuevo con el contenido de la versión validada. Esta ficha y su versión validada no cambian. El borrador se edita, se envía y pasa por revisión docente como cualquier ficha.</p>
				<label class="confirm"><input type="checkbox" name="confirm" required /> Confirmo que quiero crear una enmienda nueva. Cada confirmación crea una enmienda distinta.</label>
				<button id="amend-button" class="button" type="submit">Crear enmienda</button>
			</form>}
		{(evaluation.status !== 'draft' || correctionDraft) && <section class="history" aria-labelledby="history-title">
				<h2 id="history-title">Historial de versiones</h2>
				{historyError ? <p class="notice error" role="alert">{historyError}</p> : submissions.length ? submissions.map((submission) => <SubmissionSnapshot submission={submission} corrections={corrections} crossContext={crossContext} />) : <p>No hay versiones enviadas para esta ficha.</p>}
			</section>}
		</> : <section class="notice error" role="alert">
			<h1 id="title">No se pudo cargar la ficha</h1>
			<p>{errorText || 'Volvé a la asignación e intentá nuevamente.'}</p>
			<a href={contextHref}>Volver a la asignación</a>
		</section>}
		{(unavailable || loadError) && retainedContent && <section class="preserved" aria-labelledby="preserved-title">
			<h2 id="preserved-title">Valores del formulario conservados</h2>
			{c.admission_date && <p><strong>Fecha de ingreso:</strong> {c.admission_date}</p>}
			{textFields.map(([key, label]) => c[key] && <p><strong>{label}:</strong> {c[key]}</p>)}
			{c.antecedents && <p><strong>Antecedentes:</strong> {Object.entries(c.antecedents).map(([key, value]) => `${key}: ${value === null ? 'sin determinar' : value}`).join(' · ')}</p>}
			{c.studies?.map((study) => <p><strong>{study.type || 'Estudio incompleto'}:</strong> {study.description}{study.date ? ` · ${study.date}` : ''}</p>)}
		</section>}
	</main>
	<script>
		const studies = document.querySelector<HTMLElement>('#studies');
		let rowIndex = studies?.querySelectorAll('.study-row').length ?? 0;
		document.querySelector<HTMLButtonElement>('#add-study')?.addEventListener('click', () => {
			if (!studies) return;
			const row = document.createElement('div');
			row.className = 'study-row';
			row.innerHTML = `<label>Tipo <input name="study-type-${rowIndex}" /></label><label>Descripción <textarea name="study-description-${rowIndex}"></textarea></label><label>Fecha <input name="study-date-${rowIndex}" type="date" /></label><button class="remove-study" type="button" aria-label="Quitar estudio">Quitar estudio</button>`;
			studies.append(row);
			rowIndex++;
		});
		const submitForm = document.querySelector<HTMLFormElement>('#submit-form');
		const submitButton = document.querySelector<HTMLButtonElement>('#submit-button');
		const dirtyNotice = document.querySelector<HTMLElement>('#dirty-notice');
		const discardButton = document.querySelector<HTMLButtonElement>('#discard-button');
		let dirty = false;
		// Submission sends only the saved version, so any unsaved edit blocks it.
		const markDirty = () => {
			dirty = true;
			if (submitButton) submitButton.disabled = true;
			if (dirtyNotice) dirtyNotice.hidden = false;
			if (discardButton) discardButton.hidden = false;
		};
		const evaluationForm = document.querySelector<HTMLFormElement>('#evaluation-form');
		evaluationForm?.addEventListener('input', markDirty);
		evaluationForm?.addEventListener('change', markDirty);
		discardButton?.addEventListener('click', () => {
			window.location.assign(window.location.pathname + window.location.search);
		});
		studies?.addEventListener('click', (event) => {
			const target = event.target;
			if (target instanceof Element && target.closest('.remove-study')) {
				target.closest('.study-row')?.remove();
				markDirty();
			}
		});
		const amendForm = document.querySelector<HTMLFormElement>('#amend-form');
		const amendButton = document.querySelector<HTMLButtonElement>('#amend-button');
		// Each POST creates a separate amendment, so a second click is ignored.
		amendForm?.addEventListener('submit', (event) => {
			if (amendForm.dataset.submitting === 'true') {
				event.preventDefault();
				return;
			}
			amendForm.dataset.submitting = 'true';
			if (amendButton) {
				amendButton.disabled = true;
				amendButton.textContent = 'Creando…';
			}
		});
		submitForm?.addEventListener('submit', (event) => {
			if (dirty || submitForm.dataset.submitting === 'true') {
				event.preventDefault();
				return;
			}
			submitForm.dataset.submitting = 'true';
			if (submitButton) {
				submitButton.disabled = true;
				submitButton.textContent = 'Enviando…';
			}
		});
	</script>
</Layout>

<style>
	.clinical-page {
		max-width: 58rem;
		margin: 0 auto;
		padding: 1.5rem 0 3rem;
		color: var(--ink);
	}
	.eyebrow a { color: var(--rust-deep); text-decoration: underline; }
	.patient { font-weight: 700; }
	.context { line-height: 1.6; }
	.identifier { overflow-wrap: anywhere; }
	.notice, .success, .error, .preserved {
		margin: 1rem 0;
		padding: 1rem;
		border: 1px solid var(--line);
		border-radius: 0.65rem;
		background: var(--paper);
	}
	.error { border-color: var(--rust-line); background: var(--rust-soft); }
	.success { border-color: var(--sage); background: var(--sage-soft); }
	.status, .submit-panel, .history { margin: 1rem 0; padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: 0.75rem; background: var(--paper); }
	.status h2, .submit-panel h2 { margin: 0 0 0.5rem; font-size: 1.1rem; }
	.button:disabled { opacity: 0.65; cursor: not-allowed; }
	fieldset {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 1rem 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		background: var(--paper);
	}
	legend { padding: 0 0.5rem; font-weight: 700; }
	label { display: grid; gap: 0.35rem; font-weight: 600; }
	label.confirm { display: flex; align-items: flex-start; gap: 0.5rem; margin: 0 0 0.75rem; }
	input, textarea, select {
		min-width: 0;
		padding: 0.65rem;
		border: 1px solid var(--field-line);
		border-radius: 0.35rem;
		background: var(--field);
		color: var(--ink);
		font: inherit;
	}
	textarea { min-height: 5rem; resize: vertical; }
	.button {
		padding: 0.7rem 0.95rem;
		border: 1px solid var(--rust-deep);
		border-radius: 0.4rem;
		background: var(--rust);
		color: white;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}
	.button.secondary { border-color: var(--sage-deep); background: var(--sage-soft); color: var(--ink); }
