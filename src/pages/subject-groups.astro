---
export const prerender = false;

import { actions, isInputError } from 'astro:actions';
import Layout from '../layouts/Layout.astro';
import SubjectGroupForm from '../pods/subject-group/components/SubjectGroupForm.astro';
import SubjectGroupList from '../pods/subject-group/components/SubjectGroupList.astro';
import { listSubjectGroups, parseSubjectGroupFilter, subjectGroupClearFilterHref, subjectGroupFilterHref, subjectGroupPageHref } from '../pods/subject-group/api';
import type { SubjectGroupAssociation } from '../pods/subject-group/api';
import { listSubjects } from '../pods/subject/api';
import type { SubjectSummary } from '../pods/subject/api';
import { academicPaginationNavigation, parseAcademicPagination } from '../shared/academic-api';
import { getSession } from '../shared/session';

const returnTo = '/auth/login?returnTo=%2Fsubject-groups';
if (!getSession(Astro.cookies)) return Astro.redirect(returnTo);

const actionResult = Astro.getActionResult(actions.createSubjectGroup);
let recoveredSubjectId = '';
let recoveredAcademicGroupId = '';
if (actionResult?.data) {
	recoveredSubjectId = actionResult.data.subjectId ?? '';
	recoveredAcademicGroupId = actionResult.data.academicGroupId ?? '';
} else if (actionResult?.error && isInputError(actionResult.error)) {
	try {
		const submitted = await Astro.request.clone().formData();
		const subjectValue = submitted.get('subject_id');
		const groupValue = submitted.get('academic_group_id');
		recoveredSubjectId = typeof subjectValue === 'string' ? subjectValue : '';
		recoveredAcademicGroupId = typeof groupValue === 'string' ? groupValue : '';
	} catch {
		// Framework input errors may not include a safely recoverable form body.
	}
}

const search = Astro.url.searchParams;
let state: 'success' | 'denied' | 'failed' | 'invalid-pagination' | 'invalid-filter' = 'failed';
let items: SubjectGroupAssociation[] = [];
let limit = 50;
let offset = 0;
let subjectId: string | null = null;
let previousHref: string | null = null;
let nextHref: string | null = null;
let invalidMessage = 'Revisá los parámetros de consulta.';
let subjectCatalogState: 'success' | 'denied' | 'failed' | 'invalid-pagination' = 'failed';
let subjects: SubjectSummary[] = [];
let subjectLimit = 50;
let subjectOffset = 0;
let subjectCatalogMessage = 'No se pudo consultar el catálogo de asignaturas.';
try {
	const subjectParams = new URLSearchParams();
	for (const [source, target] of [['subject_limit', 'limit'], ['subject_offset', 'offset']] as const) {
		for (const value of search.getAll(source)) subjectParams.append(target, value);
	}
	const pagination = parseAcademicPagination(subjectParams);
	subjectLimit = pagination.limit;
	subjectOffset = pagination.offset;
	const result = await listSubjects(pagination, Astro.cookies);
	subjectCatalogState = result.state;
	if (result.state === 'success') subjects = result.page.items;
} catch (error) {
	if (error instanceof Error && error.message.includes('paginación')) {
		subjectCatalogState = 'invalid-pagination';
		subjectCatalogMessage = error.message;
	} else {
		return Astro.redirect(returnTo);
	}
}

const actionParams = new URLSearchParams(actions.createSubjectGroup.toString().split('?')[1] ?? '');
actionParams.set('limit', String(limit));
actionParams.set('offset', String(offset));
actionParams.set('subject_limit', String(subjectLimit));
actionParams.set('subject_offset', String(subjectOffset));
let actionUrl = `/subject-groups?${actionParams}`;
try {
	const pagination = parseAcademicPagination(search);
	const filter = parseSubjectGroupFilter(search);
	limit = pagination.limit;
	offset = pagination.offset;
	subjectId = filter.subjectId;
	actionParams.set('limit', String(limit));
	actionParams.set('offset', String(offset));
	if (subjectId !== null) actionParams.set('subject_id', subjectId);
	actionUrl = `/subject-groups?${actionParams}`;
	const result = await listSubjectGroups(pagination, filter, Astro.cookies);
	state = result.state;
	if (result.state === 'success') {
		items = result.page.items;
		const navigation = academicPaginationNavigation({ ...pagination, itemsLength: items.length });
		previousHref = navigation.previousOffset === null ? null : subjectGroupPageHref(search, pagination, navigation.previousOffset);
		nextHref = navigation.nextOffset === null ? null : subjectGroupPageHref(search, pagination, navigation.nextOffset);
	}
} catch (error) {
	if (error instanceof Error && error.message.includes('paginación')) {
		state = 'invalid-pagination';
		invalidMessage = error.message;
	} else if (error instanceof Error && error.message.includes('filtro')) {
		state = 'invalid-filter';
		invalidMessage = error.message;
	} else {
		return Astro.redirect(returnTo);
	}
}

const filterHref = subjectGroupFilterHref(search, subjectId ?? '', limit);
const clearFilterHref = subjectGroupClearFilterHref(search, limit);
---

<Layout>
	<main aria-labelledby="subject-groups-title">
		<header class="intro">
			<p class="eyebrow">Gestión / Asociaciones académicas</p>
			<h1 id="subject-groups-title">Grupos por asignatura</h1>
			<p>Consultá las asociaciones registradas entre asignaturas y grupos académicos.</p>
		</header>
		<SubjectGroupForm result={actionResult} subjectId={recoveredSubjectId} academicGroupId={recoveredAcademicGroupId} actionUrl={actionUrl} subjects={subjects} subjectCatalogState={subjectCatalogState} subjectCatalogMessage={subjectCatalogMessage} />
		<SubjectGroupList
			state={state}
			items={items}
			limit={limit}
			offset={offset}
			subjectId={subjectId}
			filterHref={filterHref}
			clearFilterHref={clearFilterHref}
			previousHref={previousHref}
			nextHref={nextHref}
			invalidMessage={invalidMessage}
		/>
	</main>
</Layout>

<style>
	main { max-width: 1280px; min-width: 0; margin: 0 auto; }
	.intro { margin-bottom: 2rem; }
	.intro p { margin: 0.75rem 0; color: var(--muted); }
	.eyebrow { font: 0.65rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	h1 { margin: 0.5rem 0; font: 400 clamp(2rem, 3vw, 2.75rem)/1.15 var(--serif); }
</style>
