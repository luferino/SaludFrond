---
export const prerender = false;

import { actions, isInputError } from 'astro:actions';
import Layout from '../layouts/Layout.astro';
import '../styles/academic-panels.css';
import SubjectGroupForm from '../pods/subject-group/components/SubjectGroupForm.astro';
import SubjectGroupList from '../pods/subject-group/components/SubjectGroupList.astro';
import { listSubjectGroups, parseSubjectGroupFilter, subjectGroupClearFilterHref, subjectGroupFilterHref, subjectGroupPageHref } from '../pods/subject-group/api';
import type { SubjectGroupAssociation } from '../pods/subject-group/api';
import { listSubjects } from '../pods/subject/api';
import type { SubjectSummary } from '../pods/subject/api';
import { listGroups } from '../pods/group/api';
import type { GroupSummary } from '../pods/group/api';
import { academicPaginationNavigation, parseAcademicPagination } from '../shared/academic-api';
import { getSession } from '../shared/session';

const returnTo = '/auth/login?returnTo=%2Fsubject-groups';
if (!getSession(Astro.cookies)) return Astro.redirect(returnTo);

const actionResult = Astro.getActionResult(actions.createSubjectGroup);
let recoveredSubjectId = '';
let recoveredAcademicGroupId = '';
if (actionResult?.data) {
	recoveredSubjectId = actionResult.data.subjectId ?? '';
	recoveredAcademicGroupId = actionResult.data.academicGroupId ?? '';
} else if (actionResult?.error && isInputError(actionResult.error)) {
	try {
		const submitted = await Astro.request.clone().formData();
		const subjectValue = submitted.get('subject_id');
		const groupValue = submitted.get('academic_group_id');
		recoveredSubjectId = typeof subjectValue === 'string' ? subjectValue : '';
		recoveredAcademicGroupId = typeof groupValue === 'string' ? groupValue : '';
	} catch {
		// Framework input errors may still have no safely recoverable form body.
	}
}

const search = Astro.url.searchParams;
const oneDraft = (name: string) => {
	const values = search.getAll(name);
	return values.length === 1 ? values[0] : '';
};
if (Astro.request.method === 'GET' && !actionResult) {
	recoveredSubjectId = oneDraft('draft_subject_id');
	recoveredAcademicGroupId = oneDraft('draft_academic_group_id');
}

let state: 'success' | 'denied' | 'failed' | 'invalid-pagination' | 'invalid-filter' = 'failed';
let items: SubjectGroupAssociation[] = [];
let limit = 50;
let offset = 0;
let subjectId: string | null = null;
let previousHref: string | null = null;
let nextHref: string | null = null;
let invalidMessage = 'Revisá los parámetros de consulta.';
const actionParams = new URLSearchParams(actions.createSubjectGroup.toString());
actionParams.set('limit', String(limit));
actionParams.set('offset', String(offset));
try {
	const pagination = parseAcademicPagination(search);
	const filter = parseSubjectGroupFilter(search);
	limit = pagination.limit;
	offset = pagination.offset;
	subjectId = filter.subjectId;
	actionParams.set('limit', String(pagination.limit));
	actionParams.set('offset', String(pagination.offset));
	if (filter.subjectId !== null) actionParams.set('subject_id', filter.subjectId);
	const result = await listSubjectGroups(pagination, filter, Astro.cookies);
	state = result.state;
	if (result.state === 'success') {
		items = result.page.items;
		const navigation = academicPaginationNavigation({ ...pagination, itemsLength: items.length });
		previousHref = navigation.previousOffset === null ? null : subjectGroupPageHref(search, pagination, navigation.previousOffset);
		nextHref = navigation.nextOffset === null ? null : subjectGroupPageHref(search, pagination, navigation.nextOffset);
	}
} catch (error) {
	if (error instanceof Error && error.message.includes('paginación')) {
		state = 'invalid-pagination';
		invalidMessage = error.message;
	} else if (error instanceof Error && error.message.includes('filtro')) {
		state = 'invalid-filter';
		invalidMessage = error.message;
	} else {
		return Astro.redirect(returnTo);
	}
}

let groupCatalogState: 'success' | 'denied' | 'failed' | 'invalid-pagination' = 'failed';
let groups: GroupSummary[] = [];
let groupLimit = 50;
let groupOffset = 0;
let groupPreviousHref: string | null = null;
let groupNextHref: string | null = null;
let groupCatalogMessage = 'No se pudo consultar el catálogo de grupos académicos.';

let subjectCatalogState: 'success' | 'denied' | 'failed' | 'invalid-pagination' = 'failed';
let subjects: SubjectSummary[] = [];
let subjectLimit = 50;
let subjectOffset = 0;
let subjectPreviousHref: string | null = null;
let subjectNextHref: string | null = null;
let subjectPreviousOffset: number | null = null;
let subjectNextOffset: number | null = null;
let subjectCatalogMessage = 'No se pudo consultar el catálogo de asignaturas.';
try {
	const catalogParams = new URLSearchParams();
	for (const [source, target] of [['subject_limit', 'limit'], ['subject_offset', 'offset']] as const) {
		for (const value of search.getAll(source)) catalogParams.append(target, value);
	}
	const pagination = parseAcademicPagination(catalogParams);
	subjectLimit = pagination.limit;
	subjectOffset = pagination.offset;
	const result = await listSubjects(pagination, Astro.cookies);
	subjectCatalogState = result.state;
	if (result.state === 'success') {
		subjects = result.page.items;
		const navigation = academicPaginationNavigation({ ...pagination, itemsLength: subjects.length });
		subjectPreviousOffset = navigation.previousOffset;
		subjectNextOffset = navigation.nextOffset;
	}
} catch (error) {
	if (error instanceof Error && error.message.includes('paginación')) {
		subjectCatalogState = 'invalid-pagination';
		subjectCatalogMessage = error.message;
	} else {
		return Astro.redirect(returnTo);
	}
}

try {
	const catalogParams = new URLSearchParams();
	for (const [source, target] of [['group_limit', 'limit'], ['group_offset', 'offset']] as const) {
		for (const value of search.getAll(source)) catalogParams.append(target, value);
	}
	const pagination = parseAcademicPagination(catalogParams);
	groupLimit = pagination.limit;
	groupOffset = pagination.offset;
	const result = await listGroups(pagination, Astro.cookies);
	groupCatalogState = result.state;
	if (result.state === 'success') {
		groups = result.page.items;
		const navigation = academicPaginationNavigation({ ...pagination, itemsLength: groups.length });
		const href = (catalogOffset: number) => {
			const params = new URLSearchParams({ limit: String(limit), offset: String(offset), subject_limit: String(subjectLimit), subject_offset: String(subjectOffset), group_limit: String(pagination.limit), group_offset: String(catalogOffset) });
			if (subjectId !== null) params.set('subject_id', subjectId);
			if (recoveredSubjectId) params.set('draft_subject_id', recoveredSubjectId);
			if (recoveredAcademicGroupId) params.set('draft_academic_group_id', recoveredAcademicGroupId);
			return `/subject-groups?${params}`;
		};
		groupPreviousHref = navigation.previousOffset === null ? null : href(navigation.previousOffset);
		groupNextHref = navigation.nextOffset === null ? null : href(navigation.nextOffset);
	}
} catch (error) {
	if (error instanceof Error && error.message.includes('paginación')) {
		groupCatalogState = 'invalid-pagination';
		groupCatalogMessage = error.message;
	} else {
		return Astro.redirect(returnTo);
	}
}

if (subjectCatalogState === 'success') {
	const subjectHref = (catalogOffset: number) => {
		const params = new URLSearchParams({ limit: String(limit), offset: String(offset), subject_limit: String(subjectLimit), subject_offset: String(catalogOffset), group_limit: String(groupLimit), group_offset: String(groupOffset) });
		if (subjectId !== null) params.set('subject_id', subjectId);
		if (recoveredSubjectId) params.set('draft_subject_id', recoveredSubjectId);
		if (recoveredAcademicGroupId) params.set('draft_academic_group_id', recoveredAcademicGroupId);
		return `/subject-groups?${params}`;
	};
	subjectPreviousHref = subjectPreviousOffset === null ? null : subjectHref(subjectPreviousOffset);
	subjectNextHref = subjectNextOffset === null ? null : subjectHref(subjectNextOffset);
}

actionParams.set('subject_limit', String(subjectLimit));
actionParams.set('subject_offset', String(subjectOffset));
actionParams.set('group_limit', String(groupLimit));
actionParams.set('group_offset', String(groupOffset));
const filterHref = subjectGroupFilterHref(search, subjectId ?? '', limit);
const clearFilterHref = subjectGroupClearFilterHref(search, limit);
const actionUrl = `/subject-groups?${actionParams.toString()}`;
---

<Layout>
	<main class="academic-page" aria-labelledby="subject-groups-title">
		<header class="intro">
			<p class="eyebrow">Gestión / Asociaciones académicas</p>
			<h1 id="subject-groups-title">Grupos por asignatura</h1>
			<p>Consultá las asociaciones registradas entre asignaturas y grupos académicos.</p>
		</header>
		<SubjectGroupForm result={actionResult} subjectId={recoveredSubjectId} academicGroupId={recoveredAcademicGroupId} actionUrl={actionUrl} subjects={subjects} subjectCatalogState={subjectCatalogState} subjectCatalogMessage={subjectCatalogMessage} subjectLimit={subjectLimit} subjectOffset={subjectOffset} subjectPreviousHref={subjectPreviousHref} subjectNextHref={subjectNextHref} groups={groups} groupCatalogState={groupCatalogState} groupCatalogMessage={groupCatalogMessage} groupLimit={groupLimit} groupOffset={groupOffset} groupPreviousHref={groupPreviousHref} groupNextHref={groupNextHref} listLimit={limit} listOffset={offset} listSubjectId={subjectId} />
		<SubjectGroupList
			state={state}
			items={items}
			limit={limit}
			offset={offset}
			subjectId={subjectId}
			filterHref={filterHref}
			clearFilterHref={clearFilterHref}
			previousHref={previousHref}
			nextHref={nextHref}
			invalidMessage={invalidMessage}
		/>
	</main>
</Layout>

<style>
	main { max-width: 1280px; min-width: 0; margin: 0 auto; }
	.intro { margin-bottom: 2rem; }
	.intro p { margin: 0.75rem 0; color: var(--muted); }
	.eyebrow { font: 0.65rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	h1 { margin: 0.5rem 0; font: 400 clamp(2rem, 3vw, 2.75rem)/1.15 var(--serif); }
</style>
