---
export const prerender=false;
import { actions,isInputError } from 'astro:actions';
import Layout from '../layouts/Layout.astro';
import { ApiError } from '../shared/apiClient';
import { getSession } from '../shared/session';
import { decodeJwt } from '../shared/jwt';
import { listGroups,listHistory,listLinks,listSubjects,parseAvailabilityPagination,parseSelectedPatientId,UUID_PATTERN } from '../pods/patient-availability/api';
import type { Group,Patient,PatientPeriod,Subject } from '../pods/patient-availability/api';
Astro.response.headers.set('Cache-Control','no-store');
const returnTo='/auth/login?returnTo=%2Fpatient-availability';const token=getSession(Astro.cookies);if(!token)return Astro.redirect(returnTo);if(decodeJwt(token)?.role!=='admin')return Astro.redirect('/');
const searchResult=Astro.getActionResult(actions.searchAvailablePatient);const enableResult=Astro.getActionResult(actions.enablePatientAvailability);const withdrawResult=Astro.getActionResult(actions.withdrawPatientAvailability);
if(searchResult?.data?.unauthorized||enableResult?.data?.unauthorized||withdrawResult?.data?.unauthorized)return Astro.redirect(returnTo);
let submitted:Record<string,string>={};if(enableResult?.error||withdrawResult?.error){try{submitted=Object.fromEntries([...(await Astro.request.clone().formData()).entries()].filter((entry):entry is [string,string]=>typeof entry[1]==='string'));}catch{/* Framework validation may not expose submitted fields. */}}
let feedback='';if(searchResult?.data?.success)feedback='Búsqueda completada.';if(enableResult?.data?.success)feedback='Se habilitó un nuevo período.';if(withdrawResult?.data?.success)feedback='Se retiró el período; las asignaciones y el acceso existentes permanecen.';
let errorText='';if(searchResult?.data?.success===false)errorText=searchResult.data.error;if(enableResult?.data?.success===false)errorText=enableResult.data.error;if(withdrawResult?.data?.success===false)errorText=withdrawResult.data.error;
for(const action of [searchResult,enableResult,withdrawResult])if(action?.error)errorText=isInputError(action.error)?'Revisá los datos enviados. Conservamos las selecciones válidas.':action.error.message;
const searchPatients:Patient[]=searchResult?.data?.success?searchResult.data.patients:[];const retainedDocument=searchResult?.data?.documento??'';const retainedPair=enableResult?.data?.contextPair??submitted.context_pair??'';
let queryError='';let selectedId='';try{selectedId=parseSelectedPatientId(Astro.url.searchParams)??'';}catch{queryError='El paciente seleccionado no es válido.';}
if(enableResult?.data?.patientId&&UUID_PATTERN.test(enableResult.data.patientId))selectedId=enableResult.data.patientId;
if(withdrawResult?.data?.patientId&&UUID_PATTERN.test(withdrawResult.data.patientId))selectedId=withdrawResult.data.patientId;
if(submitted.patient_id&&UUID_PATTERN.test(submitted.patient_id))selectedId=submitted.patient_id;
const selectedPatient=searchPatients.find(p=>p.patient_id.toLowerCase()===selectedId.toLowerCase());
const params=Astro.url.searchParams;let historyLimit=50,historyOffset=0,subjectLimit=50,subjectOffset=0,linkLimit=50,linkOffset=0,groupLimit=50,groupOffset=0;
const pageFor=(prefix:string)=>{const p=new URLSearchParams();for(const key of ['limit','offset'])for(const value of params.getAll(`${prefix}_${key}`))p.append(key,value);return parseAvailabilityPagination(p);};
try{({limit:historyLimit,offset:historyOffset}=pageFor('history'));({limit:subjectLimit,offset:subjectOffset}=pageFor('subject'));({limit:linkLimit,offset:linkOffset}=pageFor('link'));({limit:groupLimit,offset:groupOffset}=pageFor('group'));}catch{queryError='Revisá los parámetros de paginación.';}
const selectedSubjectParam=params.getAll('subject_id');let selectedSubjectId=selectedSubjectParam.length===1&&UUID_PATTERN.test(selectedSubjectParam[0])?selectedSubjectParam[0]:'';
if(retainedPair){const parts=retainedPair.split('|');if(parts.length===2&&parts.every(v=>UUID_PATTERN.test(v)))selectedSubjectId=parts[0];}
const previousSubjectId=params.get('current_subject_id');if(previousSubjectId&&selectedSubjectId&&previousSubjectId.toLowerCase()!==selectedSubjectId.toLowerCase())linkOffset=0;

let subjects:Subject[]=[],groups:Group[]=[],links:{subject_id:string;academic_group_id:string}[]=[],history:PatientPeriod[]=[];let subjectState='failed',linkState='idle',groupState='idle',historyState='idle';let subjectError='',linkError='',groupError='',historyError='';
const goLogin=(error:unknown)=>error instanceof ApiError&&error.status===401;
try{if(!queryError){const page=await listSubjects({limit:subjectLimit,offset:subjectOffset},Astro.cookies);subjects=page.items;subjectState='success';}}catch(error){if(goLogin(error))return Astro.redirect(returnTo);subjectState=error instanceof ApiError&&error.status===403?'denied':'failed';subjectError=subjectState==='denied'?'No tenés permiso para consultar asignaturas.':'No se pudieron cargar las asignaturas.';}
if(!selectedSubjectId&&subjects.length)selectedSubjectId=subjects[0].id;
if(!queryError&&selectedSubjectId&&subjectState==='success')try{links=(await listLinks(selectedSubjectId,{limit:linkLimit,offset:linkOffset},Astro.cookies)).items;linkState='success';}catch(error){if(goLogin(error))return Astro.redirect(returnTo);linkState=error instanceof ApiError&&error.status===403?'denied':'failed';linkError=linkState==='denied'?'No tenés permiso para consultar asociaciones.':'No se pudieron cargar las asociaciones vinculadas.';}
try{if(!queryError){groups=(await listGroups({limit:groupLimit,offset:groupOffset},Astro.cookies)).items;groupState='success';}}catch(error){if(goLogin(error))return Astro.redirect(returnTo);groupState=error instanceof ApiError&&error.status===403?'denied':'failed';groupError=groupState==='denied'?'No tenés permiso para consultar grupos.':'No se pudieron cargar los grupos.';}
if(!queryError&&selectedId)try{history=(await listHistory(selectedId,{limit:historyLimit,offset:historyOffset},Astro.cookies)).items;historyState=history.length?'success':'empty';}catch(error){if(goLogin(error))return Astro.redirect(returnTo);historyState=error instanceof ApiError&&error.status===403?'denied':'failed';historyError=historyState==='denied'?'No tenés permiso para consultar el historial.':'No se pudo cargar el historial.';}
const groupMap=new Map(groups.map(g=>[g.id.toLowerCase(),g]));const subject=subjects.find(s=>s.id.toLowerCase()===selectedSubjectId.toLowerCase());const namedLinks=links.filter(l=>l.subject_id.toLowerCase()===selectedSubjectId.toLowerCase()&&groupMap.has(l.academic_group_id.toLowerCase()));const missingLabels=links.some(l=>!groupMap.has(l.academic_group_id.toLowerCase()));
const href=(overrides:Record<string,string>)=>{const q=new URLSearchParams();if(selectedId)q.set('patient_id',selectedId);if(selectedSubjectId)q.set('subject_id',selectedSubjectId);for(const [key,val] of Object.entries({history_limit:String(historyLimit),history_offset:String(historyOffset),subject_limit:String(subjectLimit),subject_offset:String(subjectOffset),link_limit:String(linkLimit),link_offset:String(linkOffset),group_limit:String(groupLimit),group_offset:String(groupOffset),...overrides}))q.set(key,val);return `/patient-availability?${q}`;};
const pageHref=(prefix:string,nextOffset:number)=>href({[`${prefix}_offset`]:String(nextOffset)});
---
<Layout><main class="availability"><header><p class="eyebrow">Administración / Pacientes</p><h1>Disponibilidad de pacientes</h1><p>Búsqueda por documento exacto, períodos y contextos académicos vinculados.</p></header>
{errorText&&<p role="alert">{errorText}</p>}{feedback&&<p role="status">{feedback}</p>}{queryError&&<p role="alert">{queryError}</p>}
<section><h2>Buscar paciente</h2><form method="POST" action={actions.searchAvailablePatient}><label for="documento">Documento exacto</label><input id="documento" name="documento" type="text" autocomplete="off" value={retainedDocument} required/><button>Buscar</button></form>
{searchResult?.data?.success&&<div><h3>Resultados</h3>{searchPatients.length===0?<p>No se encontró un paciente con ese documento.</p>:<ul>{searchPatients.map(p=><li>{p.apellidos}, {p.nombres} <a href={href({patient_id:p.patient_id,history_offset:'0'})}>Ver historial y habilitar</a></li>)}</ul>}</div>}</section>
{selectedId&&<section><h2>{selectedPatient?`${selectedPatient.apellidos}, ${selectedPatient.nombres}`:'Paciente seleccionado'}</h2><p>Historial limitado al identificador de paciente seleccionado.</p><h3>Habilitar en contexto vinculado</h3>
{subjectError&&<p role="alert">{subjectError}</p>}{linkError&&<p role="alert">{linkError}</p>}{groupError&&<p role="alert">{groupError}</p>}
<form method="GET" action="/patient-availability"><input type="hidden" name="patient_id" value={selectedId}/><input type="hidden" name="current_subject_id" value={selectedSubjectId}/><input type="hidden" name="history_limit" value={historyLimit}/><input type="hidden" name="history_offset" value={historyOffset}/><input type="hidden" name="subject_limit" value={subjectLimit}/><input type="hidden" name="subject_offset" value={subjectOffset}/><input type="hidden" name="link_limit" value={linkLimit}/><input type="hidden" name="link_offset" value={linkOffset}/><input type="hidden" name="group_limit" value={groupLimit}/><input type="hidden" name="group_offset" value={groupOffset}/><label for="subject_id">Asignatura</label><select id="subject_id" name="subject_id" required>{subjects.map(s=><option value={s.id} selected={s.id.toLowerCase()===selectedSubjectId.toLowerCase()}>{s.name}</option>)}</select><button>Ver contextos</button></form>{subjectState==='success'&&<nav aria-label="Paginación de asignaturas"><a href={pageHref('subject',Math.max(0,subjectOffset-subjectLimit))}>Anterior</a> Página {Math.floor(subjectOffset/subjectLimit)+1} {subjectOffset+subjectLimit<=10000&&<a href={pageHref('subject',subjectOffset+subjectLimit)}>Siguiente</a>}</nav>}
{missingLabels&&<p role="status">Algunos grupos vinculados no aparecen en esta página del catálogo. Avanzá las páginas de grupos para ver sus nombres; no se ofrecen identificadores sin etiqueta.</p>}
{linkState==='success'&&groupState==='success'&&<form method="POST" action={actions.enablePatientAvailability}><input type="hidden" name="patient_id" value={selectedId}/><label for="context_pair">Grupo vinculado de {subject?.name??'la asignatura seleccionada'}</label><select id="context_pair" name="context_pair" required><option value="">Seleccioná un contexto</option>{namedLinks.map(link=>{const group=groupMap.get(link.academic_group_id.toLowerCase())!;return <option value={`${link.subject_id}|${link.academic_group_id}`} selected={retainedPair===`${link.subject_id}|${link.academic_group_id}`}>{group.name} ({group.academic_year}, cuatrimestre {group.curriculum_semester})</option>})}</select><button disabled={!namedLinks.length}>Habilitar nuevo período</button></form>}
{linkState==='success'&&<nav aria-label="Paginación de asociaciones"><a href={pageHref('link',Math.max(0,linkOffset-linkLimit))}>Anterior</a> Página {Math.floor(linkOffset/linkLimit)+1} {linkOffset+linkLimit<=10000&&<a href={pageHref('link',linkOffset+linkLimit)}>Siguiente</a>}</nav>}{groupState==='success'&&<nav aria-label="Paginación de grupos"><a href={pageHref('group',Math.max(0,groupOffset-groupLimit))}>Anterior</a> Página {Math.floor(groupOffset/groupLimit)+1} {groupOffset+groupLimit<=10000&&<a href={pageHref('group',groupOffset+groupLimit)}>Siguiente</a>}</nav>}
<h3>Historial de disponibilidad</h3>{historyError&&<p role="alert">{historyError}</p>}{historyState==='empty'&&<p>No hay períodos para este paciente en esta página.</p>}{history.length>0&&<ul>{history.map(period=><li><strong>{groupMap.get(period.academic_group_id.toLowerCase())?.name??'Grupo (nombre no disponible)'}</strong> — {subjects.find(s=>s.id.toLowerCase()===period.subject_id.toLowerCase())?.name??'Asignatura (nombre no disponible)'}; habilitado {period.enabled_at}{period.withdrawn_at?` — retirado ${period.withdrawn_at}`:' — activo'}
{!period.withdrawn_at&&<form method="POST" action={actions.withdrawPatientAvailability}><input type="hidden" name="id" value={period.id}/><input type="hidden" name="patient_id" value={selectedId}/><label><input type="checkbox" name="confirm_consequences" value="yes" required/>Confirmo retirar este período</label><p>El retiro no revoca asignaciones existentes ni el acceso asociado.</p><button>Retirar período</button></form>}</li>)}</ul>}{selectedId&&historyState!=='denied'&&<nav aria-label="Paginación del historial"><a href={pageHref('history',Math.max(0,historyOffset-historyLimit))}>Anterior</a> Página {Math.floor(historyOffset/historyLimit)+1} {historyOffset+historyLimit<=10000&&<a href={pageHref('history',historyOffset+historyLimit)}>Siguiente</a>}</nav>}
<p>Rehabilitar crea un período nuevo, no reactiva uno retirado.</p></section>}</main></Layout>
<style>.availability{max-width:62rem;margin:auto;padding:2rem 1rem;color:var(--ink)}section{margin:1.5rem 0;padding:1.25rem;border:1px solid var(--line);border-radius:.5rem;background:var(--paper)}form{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;margin:.75rem 0}input,select,button{font:inherit;padding:.55rem}li{margin:.75rem 0}</style>
