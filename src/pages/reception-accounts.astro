---
export const prerender = false;

import { actions } from 'astro:actions';
import Layout from '../layouts/Layout.astro';
import { receptionActionUrl } from '../pods/reception/action-url';
import '../styles/academic-panels.css';
import {
	isAccountId, listReceptionCareerGrants, listReceptionRoleGrants, parseAccountSelection, parseRoleStudentSelection, receptionCareerLabels, receptionCareers, ROLE_CANDIDATE_LIMIT, searchReceptionAccounts, searchReceptionRoleCandidates,
} from '../pods/reception-account/api';
import type { GrantListResult, ReceptionAccount, ReceptionAccountSearchItem, ReceptionCareerGrant, ReceptionRoleCandidate, ReceptionRoleCandidateResult, ReceptionRoleGrant } from '../pods/reception-account/api';
import { nextReceptionAccountOffset, parseReceptionAccountSearch, parseReceptionRoleSearch, RECEPTION_ROLE_QUERY_KEYS } from '../pods/reception-account/search';
import type { ReceptionAccountSearchQuery, ReceptionRoleSearchQuery } from '../pods/reception-account/search';
import { decodeJwt } from '../shared/jwt';
import { getSession } from '../shared/session';

const token = getSession(Astro.cookies);
if (!token) return Astro.redirect('/auth/login?returnTo=%2Freception-accounts');
const payload = decodeJwt(token);
// Presentation hint only; the backend checks the current permissions on each request.
if (!payload || payload.role !== 'admin') return Astro.redirect('/auth/login');

const createResult = Astro.getActionResult(actions.createReceptionAccount);
const grantResult = Astro.getActionResult(actions.grantReceptionCareer);
const revokeResult = Astro.getActionResult(actions.revokeReceptionCareerGrant);
const createData = createResult?.data as { success?: boolean; error?: string; account?: ReceptionAccount } | undefined;
const grantData = grantResult?.data as { success?: boolean; error?: string; grant?: ReceptionCareerGrant } | undefined;
const revokeData = revokeResult?.data as { success?: boolean; error?: string; id?: string; grant?: ReceptionCareerGrant } | undefined;
const grantRoleResult = Astro.getActionResult(actions.grantReceptionRole);
const revokeRoleResult = Astro.getActionResult(actions.revokeReceptionRole);
const grantRoleData = grantRoleResult?.data as { success?: boolean; error?: string; grant?: ReceptionRoleGrant } | undefined;
const revokeRoleData = revokeRoleResult?.data as { success?: boolean; error?: string; id?: string; grant?: ReceptionRoleGrant } | undefined;

let queryError = '';
let selectedAccount = '';
let searchQuery: ReceptionAccountSearchQuery = { q: '', career: '', limit: 50, offset: 0 };
// Student-role keys belong to the role section; the account parser must not see them.
const accountParams = new URLSearchParams(Astro.url.searchParams);
for (const key of RECEPTION_ROLE_QUERY_KEYS) accountParams.delete(key);
try {
	selectedAccount = parseAccountSelection(accountParams);
	searchQuery = parseReceptionAccountSearch(accountParams);
} catch (error) {
	queryError = error instanceof Error ? error.message : 'La cuenta seleccionada no es válida.';
}
let roleQueryError = '';
let selectedStudent = '';
let roleSearchQuery: ReceptionRoleSearchQuery = { q: '', offset: 0 };
try {
	roleSearchQuery = parseReceptionRoleSearch(Astro.url.searchParams);
} catch (error) {
	roleQueryError = error instanceof Error ? error.message : 'Los filtros de búsqueda no son válidos.';
}
try {
	selectedStudent = parseRoleStudentSelection(Astro.url.searchParams);
} catch (error) {
	roleQueryError = error instanceof Error ? error.message : 'El estudiante seleccionado no es válido.';
}
if (Astro.request.method === 'POST') {
	try {
		const submitted = await Astro.request.clone().formData();
		const submittedAccount = submitted.get('account_id');
		if (typeof submittedAccount === 'string' && isAccountId(submittedAccount)) selectedAccount = submittedAccount;
		const submittedStudent = submitted.get('student_id');
		if (typeof submittedStudent === 'string' && isAccountId(submittedStudent)) selectedStudent = submittedStudent;
	} catch { /* Keep the URL selection if framework input cannot be recovered. */ }
}
// Backend audit rows decide the selection after a successful write.
if (createData?.success && createData.account) selectedAccount = createData.account.id;
else if (grantData?.success && grantData.grant) selectedAccount = grantData.grant.user_id;
else if (revokeData?.success && revokeData.grant) selectedAccount = revokeData.grant.user_id;
// The student whose role was written stays selected so the history shows the result.
if (grantRoleData?.success && grantRoleData.grant) selectedStudent = grantRoleData.grant.user_id;
else if (revokeRoleData?.success && revokeRoleData.grant) selectedStudent = revokeRoleData.grant.user_id;

let grants: ReceptionCareerGrant[] = [];
let grantState: GrantListResult['state'] | 'idle' = 'idle';
let accounts: ReceptionAccountSearchItem[] = [];
let accountSearchState: 'success' | 'denied' | 'failed' | 'invalid' = queryError ? 'invalid' : 'success';
let accountSearchLimit = searchQuery.limit;
let accountSearchOffset = searchQuery.offset;
const accountPageHref = (offset: number) => {
	const params = new URLSearchParams();
	if (searchQuery.q) params.set('q', searchQuery.q);
	if (searchQuery.career) params.set('career', searchQuery.career);
	params.set('limit', String(accountSearchLimit));
	params.set('offset', String(offset));
	return `/reception-accounts?${params.toString()}`;
};
if (!queryError) {
	try {
		const result = await searchReceptionAccounts(searchQuery, Astro.cookies);
		accountSearchState = result.state;
		if (result.state === 'success') {
			accounts = result.items;
			accountSearchLimit = result.limit;
			accountSearchOffset = result.offset;
		}
	} catch {
		return Astro.redirect('/auth/login?returnTo=%2Freception-accounts');
	}
}
const nextAccountOffset = accountSearchState === 'success' ? nextReceptionAccountOffset(accountSearchOffset, accountSearchLimit, accounts.length) : null;
if (selectedAccount && !queryError) {
	try {
		const result = await listReceptionCareerGrants(selectedAccount, Astro.cookies);
		grantState = result.state;
		if (result.state === 'success') grants = result.items;
	} catch {
		return Astro.redirect('/auth/login?returnTo=%2Freception-accounts');
	}
}

let candidateState: ReceptionRoleCandidateResult['state'] | 'idle' = 'idle';
let candidates: ReceptionRoleCandidate[] = [];
if (roleSearchQuery.q && !roleQueryError) {
	try {
		const result = await searchReceptionRoleCandidates(roleSearchQuery, Astro.cookies);
		candidateState = result.state;
		if (result.state === 'success') candidates = result.items;
	} catch {
		return Astro.redirect('/auth/login?returnTo=%2Freception-accounts');
	}
}
const nextCandidateOffset = candidateState === 'success' ? nextReceptionAccountOffset(roleSearchQuery.offset, ROLE_CANDIDATE_LIMIT, candidates.length) : null;
const roleSearchHref = (offset: number) => {
	const params = new URLSearchParams();
	params.set('student_q', roleSearchQuery.q);
	params.set('student_offset', String(offset));
	return `/reception-accounts?${params.toString()}`;
};

let roleGrants: ReceptionRoleGrant[] = [];
let roleState: 'idle' | 'active' | 'revoked' | 'none' | 'denied' | 'not_found' | 'failed' = 'idle';
if (selectedStudent && !roleQueryError) {
	try {
		const result = await listReceptionRoleGrants(selectedStudent, Astro.cookies);
		if (result.state === 'success') {
			roleGrants = result.items;
			roleState = roleGrants.some((grant) => grant.revoked_at === null) ? 'active' : roleGrants.length > 0 ? 'revoked' : 'none';
		} else roleState = result.state;
	} catch {
		return Astro.redirect('/auth/login?returnTo=%2Freception-accounts');
	}
}
const activeRoleGrant = roleGrants.find((grant) => grant.revoked_at === null);
// Writes do not echo the student's identity, so the name comes from the candidate list when it is loaded.
const studentName = candidates.find((candidate) => candidate.id === selectedStudent)?.username ?? 'el estudiante';
const roleCopy = {
	revokeConfirm: (name: string) => `Revocar Recepción para ${name}. También se revocan todas sus carreras de recepción. Si se vuelve a habilitar, empezará sin carreras.`,
	grantSuccess: (name: string) => `Recepción habilitada para ${name}.`,
	revokeSuccess: (name: string) => `Recepción revocada para ${name}. Sus carreras quedaron revocadas.`,
};
---

<Layout>
	<main class="academic-page" aria-labelledby="reception-accounts-title">
		<header class="intro">
			<p class="eyebrow">Administración / Cuentas de recepción</p>
			<h1 id="reception-accounts-title">Cuentas de recepción</h1>
			<p>Creá cuentas de recepción y administrá sus accesos por carrera. Cada carrera requiere un acceso explícito; revocarlo conserva el historial.</p>
		</header>

		<section class="panel create-account" aria-labelledby="create-title">
			<h2 id="create-title">Crear cuenta</h2>
			<p class="hint">La cuenta se crea con rol de recepción. Al crearla queda seleccionada para gestionar sus carreras.</p>
			{createData?.success && <p class="notice success" role="status">Cuenta creada: <strong>{createData.account!.username}</strong>. Id: <code>{createData.account!.id}</code>.</p>}
			{createData && !createData.success && <p class="notice error" role="alert">{createData.error}</p>}
			{createResult?.error && <p class="notice error" role="alert">{createResult.error.message}</p>}
			<form class="account-form" method="POST" action={actions.createReceptionAccount}>
				<input type="hidden" name="account_id" value={selectedAccount} />
				<div class="field">
					<label for="account-username">Nombre de usuario</label>
					<input id="account-username" name="username" required autocomplete="off" />
				</div>
				<div class="field">
					<label for="account-email">Correo electrónico</label>
					<input id="account-email" name="email" type="email" required autocomplete="off" />
				</div>
				<div class="field">
					<label for="account-password">Contraseña</label>
					<input id="account-password" name="password" type="password" required autocomplete="new-password" />
				</div>
				<button type="submit">Crear cuenta</button>
			</form>
		</section>

		<section class="panel account-selection" aria-labelledby="account-title">
			<h2 id="account-title">Cuenta seleccionada</h2>
			<p class="hint">Buscá por nombre de usuario o correo. También podés filtrar por carrera con acceso activo.</p>
			{queryError && <p class="notice error" role="alert">{queryError} <a href="/reception-accounts">Volver a los valores iniciales</a></p>}
			<form class="account-lookup" method="GET" action="/reception-accounts">
				<div class="field"><label for="account-query">Usuario o correo electrónico</label><input id="account-query" name="q" value={searchQuery.q} maxlength="100" autocomplete="off" /></div>
				<div class="field"><label for="account-career">Carrera con acceso activo</label><select id="account-career" name="career"><option value="">Todas las carreras</option>{receptionCareers.map((career) => <option value={career} selected={searchQuery.career === career}>{receptionCareerLabels[career]}</option>)}</select></div>
				<input type="hidden" name="limit" value={searchQuery.limit} />
				<button type="submit">Buscar cuenta</button>
			</form>
			{accountSearchState === 'denied' && <p class="notice error" role="status">No tenés permiso para buscar cuentas de recepción.</p>}
			{accountSearchState === 'failed' && <p class="notice error" role="alert">No se pudieron cargar las cuentas. Probá de nuevo más tarde.</p>}
			{accountSearchState === 'success' && accounts.length === 0 && <p class="notice" role="status">No se encontraron cuentas con esos filtros.</p>}
			{accountSearchState === 'success' && accounts.length > 0 && <ul class="account-results">{accounts.map((account) => <li><form method="GET" action="/reception-accounts"><input type="hidden" name="account_id" value={account.id} /><button class="account-option" type="submit" aria-label={`Seleccionar ${account.username}`}><strong>{account.username}</strong><span>{account.email ?? 'Sin correo electrónico'}</span><span>{account.active_careers.length ? account.active_careers.map((career) => receptionCareerLabels[career]).join(', ') : 'Sin carreras activas'}</span></button></form></li>)}</ul>}
			{accountSearchState === 'success' && <nav class="account-pagination" aria-label="Páginas de cuentas">{accountSearchOffset > 0 && <a href={accountPageHref(Math.max(0, accountSearchOffset - accountSearchLimit))}>Anterior</a>}{nextAccountOffset !== null && <a href={accountPageHref(nextAccountOffset)}>Siguiente</a>}</nav>}
		</section>

		<section class="panel grants" aria-labelledby="grants-title">
			<h2 id="grants-title">Carreras de la cuenta</h2>
			{!selectedAccount && <p class="notice" role="status">Seleccioná una cuenta para ver y gestionar sus carreras.</p>}
			{selectedAccount && <>
				<p class="hint">Cuenta <code>{selectedAccount}</code></p>
				{grantState === 'denied' && <p class="notice error" role="status">No tenés permiso para consultar las carreras de esta cuenta.</p>}
				{grantState === 'failed' && <p class="notice error" role="alert">No se pudieron cargar las carreras de esta cuenta.</p>}
				{grantState === 'success' && grants.length === 0 && <p class="notice" role="status">Esta cuenta todavía no tiene accesos de carrera registrados.</p>}
				{grantState === 'success' && grants.length > 0 && <ul class="grant-list">
					{grants.map((grant) => <li class="grant">
						<div class="grant-heading">
							<h3>{receptionCareerLabels[grant.career]}</h3>
							<span class:list={['status', grant.revoked_at === null ? 'active' : 'revoked']}>{grant.revoked_at === null ? 'Activa' : 'Revocada'}</span>
						</div>
						<dl>
							<div><dt>Otorgada</dt><dd><time datetime={grant.granted_at}>{grant.granted_at}</time> · actor <code>{grant.granted_by}</code></dd></div>
							{grant.revoked_at && <div><dt>Revocada</dt><dd><time datetime={grant.revoked_at}>{grant.revoked_at}</time> · actor <code>{grant.revoked_by}</code></dd></div>}
						</dl>
						{grant.revoked_at === null && <details class="revoke">
							<summary>Revocar acceso</summary>
							<p>La revocación quita el acceso de recepción a esta carrera. Queda registrada en el historial y no se puede deshacer; un nuevo acceso crea otro período.</p>
							<form method="POST" action={actions.revokeReceptionCareerGrant}>
								<input type="hidden" name="account_id" value={selectedAccount} />
								<input type="hidden" name="id" value={grant.id} />
								<label class="confirm"><input type="checkbox" name="confirm" value="yes" required /> Confirmo que quiero revocar este acceso.</label>
								<button type="submit" class="danger">Confirmar revocación</button>
							</form>
						</details>}
					</li>)}
				</ul>}
				{grantData?.success && <p class="notice success" role="status">Carrera habilitada: {receptionCareerLabels[grantData.grant!.career]}.</p>}
				{grantData && !grantData.success && <p class="notice error" role="alert">{grantData.error}</p>}
				{grantResult?.error && <p class="notice error" role="alert">{grantResult.error.message}</p>}
				{revokeData?.success && <p class="notice success" role="status">Acceso revocado. Actor y hora quedan registrados por el servidor.</p>}
				{revokeData && !revokeData.success && <p class="notice error" role="alert">{revokeData.error}</p>}
				{revokeResult?.error && <p class="notice error" role="alert">{revokeResult.error.message}</p>}
				<form class="grant-form" method="POST" action={actions.grantReceptionCareer}>
					<input type="hidden" name="account_id" value={selectedAccount} />
					<div class="field">
						<label for="grant-career">Carrera</label>
						<select id="grant-career" name="career" required>
							<option value="">Elegí una carrera…</option>
							{receptionCareers.map((career) => <option value={career}>{receptionCareerLabels[career]}</option>)}
						</select>
					</div>
					<button type="submit">Habilitar carrera</button>
				</form>
			</>}
		</section>
		<section class="panel reception-role" aria-labelledby="reception-role-title">
			<h2 id="reception-role-title">Rol de Recepción adicional</h2>
			<p class="hint">Un estudiante puede tener el rol de Recepción además de su rol de estudiante. Solo el administrador lo habilita o revoca; sus carreras de recepción se gestionan aparte.</p>
			{grantRoleData?.success && <p class="notice success" role="status">{roleCopy.grantSuccess(studentName)}</p>}
			{grantRoleData && !grantRoleData.success && <p class="notice error" role="alert">{grantRoleData.error}</p>}
			{grantRoleResult?.error && <p class="notice error" role="alert">{grantRoleResult.error.message}</p>}
			{revokeRoleData?.success && <p class="notice success" role="status">{roleCopy.revokeSuccess(studentName)}</p>}
			{revokeRoleData && !revokeRoleData.success && <p class="notice error" role="alert">{revokeRoleData.error}</p>}
			{revokeRoleResult?.error && <p class="notice error" role="alert">{revokeRoleResult.error.message}</p>}
			{roleQueryError && <p class="notice error" role="alert">{roleQueryError}</p>}
			<form class="role-lookup" method="GET" action="/reception-accounts">
				<div class="field"><label for="student-query">Buscar estudiante por usuario o correo</label><input id="student-query" name="student_q" value={roleSearchQuery.q} maxlength="100" autocomplete="off" /></div>
				<button type="submit">Buscar estudiante</button>
			</form>
			{candidateState === 'idle' && !roleQueryError && <p class="hint">Escribí un usuario o correo para buscar estudiantes.</p>}
			{candidateState === 'denied' && <p class="notice error" role="status">No tenés permiso para buscar estudiantes.</p>}
			{candidateState === 'failed' && <p class="notice error" role="alert">No se pudieron cargar los estudiantes. Probá de nuevo más tarde.</p>}
			{candidateState === 'success' && candidates.length === 0 && <p class="notice" role="status">No se encontraron estudiantes con esa búsqueda.</p>}
			{candidateState === 'success' && candidates.length > 0 && <ul class="account-results">{candidates.map((candidate) => <li><form method="GET" action="/reception-accounts"><input type="hidden" name="student_q" value={roleSearchQuery.q} /><input type="hidden" name="student_offset" value={roleSearchQuery.offset} /><input type="hidden" name="student_id" value={candidate.id} /><button class="account-option" type="submit" aria-label={`Seleccionar estudiante ${candidate.username}`}><strong>{candidate.username}</strong><span>{candidate.email ?? 'Sin correo electrónico'}</span></button></form></li>)}</ul>}
			{candidateState === 'success' && <nav class="account-pagination" aria-label="Páginas de estudiantes">{roleSearchQuery.offset > 0 && <a href={roleSearchHref(Math.max(0, roleSearchQuery.offset - ROLE_CANDIDATE_LIMIT))}>Anterior</a>}{nextCandidateOffset !== null && <a href={roleSearchHref(nextCandidateOffset)}>Siguiente</a>}</nav>}
			{!selectedStudent && <p class="notice" role="status">Seleccioná un estudiante para ver o cambiar su rol de Recepción.</p>}
			{selectedStudent && <>
				<p class="hint">Estudiante <code>{selectedStudent}</code></p>
				{roleState === 'active' && <p class="status active" role="status">Recepción activa</p>}
				{roleState === 'revoked' && <p class="status revoked" role="status">Recepción revocada</p>}
				{roleState === 'none' && <p class="status" role="status">Sin rol de Recepción</p>}
				{roleState === 'denied' && <p class="notice error" role="status">No tenés permiso para consultar el rol de Recepción de este estudiante.</p>}
				{roleState === 'not_found' && <p class="notice error" role="status">No se encontró el estudiante o el rol indicado.</p>}
				{roleState === 'failed' && <p class="notice error" role="alert">No se pudo cargar el rol de Recepción de este estudiante.</p>}
				{activeRoleGrant && <p class="hint"><a href={`/reception-accounts?account_id=${selectedStudent}`}>Gestionar carreras de esta cuenta</a></p>}
				{activeRoleGrant && <details class="revoke">
					<summary>Revocar Recepción</summary>
					<p>{roleCopy.revokeConfirm(studentName)}</p>
					<form method="POST" action={receptionActionUrl(Astro.url, String(actions.revokeReceptionRole))}>
						<input type="hidden" name="student_id" value={selectedStudent} />
						<input type="hidden" name="id" value={activeRoleGrant.id} />
						<label class="confirm"><input type="checkbox" name="confirm" value="yes" required /> Confirmo que quiero revocar esta Recepción.</label>
						<button type="submit" class="danger">Revocar Recepción</button>
					</form>
				</details>}
				{(roleState === 'none' || roleState === 'revoked') && <form class="role-form" method="POST" action={receptionActionUrl(Astro.url, String(actions.grantReceptionRole))}>
					<input type="hidden" name="student_id" value={selectedStudent} />
					<button type="submit">Habilitar Recepción</button>
				</form>}
			</>}
		</section>
	</main>
</Layout>

<style>
	main { max-width: 1180px; min-width: 0; margin: 0 auto; }
	.intro { margin-bottom: 2rem; }
	.intro p { margin: 0.75rem 0; color: var(--muted); }
	.eyebrow { font: 0.65rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	h1 { margin: 0.5rem 0; font: 400 clamp(2rem, 3vw, 2.75rem)/1.15 var(--serif); }
	h2 { margin: 0 0 1rem; font: 1.45rem/1.3 var(--serif); }
	h3 { margin: 0; font: 1.2rem/1.3 var(--serif); }
	.hint { color: var(--muted); }
	.account-form, .account-lookup, .grant-form, .role-lookup, .role-form { display: grid; gap: 1rem; max-width: 48rem; margin-top: 1rem; }
	.account-results { display: grid; gap: 0.75rem; margin: 1rem 0; padding: 0; list-style: none; }
	.account-option { display: grid; gap: 0.2rem; width: 100%; text-align: left; }
	.account-option span { font-size: 0.9rem; font-weight: 400; overflow-wrap: anywhere; }
	.account-pagination { display: flex; gap: 1rem; margin-top: 1rem; }
	.field { display: grid; gap: 0.4rem; min-width: 0; }
	label { font-weight: 600; }
	input:not([type="checkbox"]), select { width: 100%; min-width: 0; min-height: 44px; padding: 0.6rem 0.75rem; border: 1px solid var(--field-line); border-radius: 6px; background: var(--field); color: var(--ink); font: inherit; }
	input:focus-visible, select:focus-visible, button:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--sage-deep); outline-offset: 3px; }
	button { width: fit-content; padding: 0.65rem 1rem; border: 0; border-radius: 6px; background: var(--rust); color: var(--field); font: inherit; font-weight: 600; cursor: pointer; }
	button:hover { background: var(--rust-deep); }
	button:disabled { opacity: 0.55; cursor: not-allowed; }
	.notice { padding: 0.9rem 1rem; border-inline-start: 4px solid var(--sage); border-radius: 0 6px 6px 0; background: var(--sage-soft); overflow-wrap: anywhere; }
	.error, .danger { border-inline-start-color: var(--rust); }
	.success { border-inline-start-color: var(--sage-deep); }
	.grant-list { display: grid; gap: 1rem; margin: 1rem 0; padding: 0; list-style: none; }
	.grant { min-width: 0; padding: 1.25rem; border: 1px solid var(--line); border-radius: 8px; background: var(--field); }
	.grant-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.6rem; align-items: baseline; }
	.status { font-weight: 700; }
	.status.revoked { color: var(--muted); }
	dl { display: grid; gap: 0.9rem; margin: 1rem 0; }
	dt { color: var(--muted); font-size: 0.85rem; font-weight: 600; }
	dd { margin: 0.25rem 0 0; overflow-wrap: anywhere; }
	code { color: var(--ink); font: 0.85rem/1.5 Consolas, monospace; overflow-wrap: anywhere; }
	.revoke { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
	.revoke summary { width: fit-content; color: var(--rust-deep); font-weight: 700; cursor: pointer; }
	.revoke form { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.75rem; }
	.confirm { display: flex; align-items: center; gap: 0.5rem; }
	.confirm input { width: 1.15rem; height: 1.15rem; }
	.danger { background: var(--rust-deep); }
	.grant-form { grid-template-columns: minmax(0, 1fr); }
</style>
