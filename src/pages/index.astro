---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getSession } from '../shared/session';
import { isTokenValid } from '../shared/jwt';

const token = getSession(Astro.cookies);
const isAuthed = token !== null && isTokenValid(token);

if (!isAuthed) {
	return Astro.redirect('/auth/login?returnTo=' + encodeURIComponent('/'));
}
---

<Layout>
	<main aria-labelledby="home-title">
		<section class="welcome">
			<p class="eyebrow">Tu espacio de trabajo</p>
			<h1 id="home-title">Bienvenido a Salud</h1>
			<p class="welcome-message">Las personas, en el centro.</p>
			<p>Selecciona una sección del menú de navegación para comenzar.</p>
		</section>
	</main>
</Layout>

<style>
	main { max-width: 1040px; margin: 0 auto; }
	.welcome { padding: clamp(1.5rem, 4vw, 3rem); background: var(--paper); border: 1px solid var(--line); border-radius: 12px; border-top: 4px solid var(--sage); }
	.eyebrow { margin: 0 0 1rem; color: var(--rust); font: 0.65rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	h1 { margin: 0; font: 400 clamp(2rem, 3vw, 2.75rem)/1.15 var(--serif); }
	.welcome-message { margin: 1rem 0; font: italic 1.25rem/1.6 var(--serif); }
	.welcome > p:last-child { margin-bottom: 0; color: var(--muted); }
</style>
