---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getSession } from '../shared/session';
import { isTokenValid } from '../shared/jwt';

const token = getSession(Astro.cookies);
const isAuthed = token !== null && isTokenValid(token);

if (!isAuthed) {
	return Astro.redirect('/login?returnTo=' + encodeURIComponent('/'));
}
---

<Layout>
	<main>
		<h1>Salud Frontend</h1>
		<p>Bienvenido. Tu sesión está activa.</p>
	</main>
</Layout>
