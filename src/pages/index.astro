---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getSession } from '../shared/session';
import { decodeJwt, isTokenValid } from '../shared/jwt';

const token = getSession(Astro.cookies);
const isAuthed = token !== null && isTokenValid(token);

if (!isAuthed) {
	return Astro.redirect('/auth/login?returnTo=' + encodeURIComponent('/'));
}

const payload = token ? decodeJwt(token) : null;
const isAdmin = payload?.role === 'admin';
// Navigation hint only; registration authorization remains on the backend.
const canRegister = Array.isArray(payload?.permissions)
	&& payload.permissions.every((permission) => typeof permission === 'string')
	&& payload.permissions.includes('users:write');
const modules = [
	{ href: '/patients', title: 'Pacientes', description: 'Registra datos personales y de contacto para dar de alta a un paciente.', label: 'Atención', tone: 'sage', visible: isAdmin },
	{ href: '/students', title: 'Estudiantes', description: 'Completa los datos necesarios para dar de alta a un estudiante.', label: 'Formación', tone: 'peach', visible: isAdmin },
	{ href: '/teachers', title: 'Profesores', description: 'Accede al formulario de alta de profesores.', label: 'Equipo docente', tone: 'sand', visible: isAdmin },
	{ href: '/auth/register', title: 'Usuarios', description: 'Crea una cuenta de estudiante sin cerrar tu sesión actual.', label: 'Acceso al sistema', tone: 'sand', visible: canRegister },
].filter((module) => module.visible);
---

<Layout>
	<main aria-labelledby="home-title">
		<div class="intro">
			<p class="eyebrow">Panel de inicio</p>
			<h1 id="home-title">Las personas, en el centro.</h1>
			<p>Accede a las herramientas de gestión disponibles para tu cuenta.</p>
		</div>
		<div class="dashboard">
			<section aria-labelledby="modules-title">
				<div class="section-heading">
					<h2 id="modules-title">Tu espacio de trabajo</h2>
					<span class="eyebrow">Accesos directos</span>
				</div>
				{modules.length > 0 ? (
					<div class="module-grid">
						{modules.map((module) => (
							<a class:list={['module-card', module.tone]} href={module.href}>
								<span class="eyebrow">{module.label}</span>
								<h3>{module.title}</h3>
								<p>{module.description}</p>
								<span class="card-action">Abrir formulario <span aria-hidden="true">↗</span></span>
							</a>
						))}
					</div>
				) : (
					<div class="empty-state">
						<h3>Tu sesión está activa</h3>
						<p>No hay accesos de gestión disponibles para tu cuenta en este panel. Si necesitas realizar una gestión, consulta con la administración.</p>
					</div>
				)}
				<div class="privacy-note">
					<span class="eyebrow">Cuidado de la información</span>
					<p>Los datos de salud son confidenciales. Utiliza solo la información necesaria para cada gestión.</p>
				</div>
			</section>
			<aside class="session-panel" aria-labelledby="session-title">
				<p class="eyebrow">Antes de comenzar</p>
				<h2 id="session-title">Una gestión cuidada</h2>
				<p>Selecciona un módulo y completa su formulario. Revisa los datos antes de enviarlos.</p>
				<ol>
					<li><strong>Elige la gestión</strong><span>Los accesos se muestran según tu cuenta.</span></li>
					<li><strong>Verifica la información</strong><span>Confirma que los datos sean correctos y estén completos.</span></li>
					<li><strong>Protege tu sesión</strong><span>Al terminar, cierra la sesión en equipos compartidos.</span></li>
				</ol>
				<a class="exit-link" href="/logout">Cerrar sesión <span aria-hidden="true">↗</span></a>
				<p class="panel-footnote">El acceso a cada operación está sujeto a tus permisos vigentes.</p>
			</aside>
		</div>
	</main>
</Layout>

<style>
	main { max-width: 1320px; margin: 0 auto; }
	h1, h2, h3 { font-family: var(--serif); font-weight: 400; }
	h1 { margin: 0.5rem 0; font-size: clamp(2rem, 3vw, 2.75rem); line-height: 1.15; }
	h2 { margin: 0; font-size: 1.5rem; line-height: 1.3; }
	h3 { margin: 0.75rem 0; font-size: 1.65rem; line-height: 1.2; }
	p { margin: 0.75rem 0; }
	.eyebrow { font: 0.65rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	.intro { padding-bottom: 1.75rem; border-bottom: 1px solid var(--line); margin-bottom: 2rem; }
	.intro > p { color: var(--muted); }
	.dashboard { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 0.48fr); gap: 2rem; align-items: start; }
	.section-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.75rem; margin-bottom: 2rem; }
	.section-heading .eyebrow { color: var(--muted); }
	.module-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.25rem; }
	.module-card {
		--folder: #e6d8bb;
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid #b8ab93;
		border-radius: 0 12px 12px 12px;
		background: var(--folder);
		color: var(--ink);
		text-decoration: none;
	}
	.module-card::before {
		content: '';
		position: absolute;
		top: -13px;
		left: -1px;
		width: 45%;
		height: 13px;
		border: 1px solid #b8ab93;
		border-bottom: 0;
		border-radius: 8px 8px 0 0;
		background: var(--folder);
	}
	.sage { --folder: #d4ddca; }
	.peach { --folder: #edcdbb; }
	.module-card p { margin: 0 0 1.5rem; font-size: 0.875rem; }
	.card-action { display: flex; justify-content: space-between; gap: 0.5rem; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid #b8ab93; font-size: 0.8rem; font-weight: 600; }
	.module-card:hover .card-action { text-decoration: underline; text-underline-offset: 4px; }
	.session-panel, .empty-state { padding: 1.75rem; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; }
	.session-panel > .eyebrow { color: var(--rust); margin-top: 0; }
	.session-panel > p:not(.eyebrow) { color: var(--muted); font-size: 0.875rem; }
	ol { list-style: decimal-leading-zero; padding-left: 1.5rem; margin: 1.5rem 0; }
	li { padding: 1rem 0 1rem 0.5rem; border-top: 1px solid var(--line); font-size: 0.8125rem; }
	li::marker { color: var(--rust); font-family: Consolas, monospace; }
	li strong, li span { display: block; }
	li span { color: var(--muted); margin-top: 0.25rem; }
	.exit-link { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 1rem; color: var(--paper); background: var(--rust); border-radius: 6px; text-decoration: none; font-weight: 600; }
	.exit-link:hover { background: var(--rust-deep); }
	.panel-footnote { margin: 1rem 0 0; }
	.privacy-note { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.8125rem; }
	.empty-state h3 { margin-top: 0; }
	@media (max-width: 1100px) {
		.dashboard { grid-template-columns: minmax(0, 1fr); }
	}
	@media (max-width: 480px) {
		.module-grid { grid-template-columns: minmax(0, 1fr); }
		.session-panel, .empty-state, .module-card { padding: 1.25rem; }
	}
</style>
