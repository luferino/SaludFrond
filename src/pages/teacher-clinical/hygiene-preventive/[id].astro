---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import HygieneReadOnly from '../../../components/clinical/HygieneReadOnly.astro';
import HygieneConsentHistory from '../../../components/clinical/HygieneConsentHistory.astro';
import HygieneProcedureLog from '../../../components/clinical/HygieneProcedureLog.astro';
import { ApiError } from '../../../shared/apiClient';
import { parseClinicalContext, teacherGrant, type ClinicalContext } from '../../../pods/teacher-clinical/api';
import { getHygieneConsent, getHygieneDraft, listHygieneProcedures, validId, type HygieneConsentHistory as ConsentHistory, type HygieneDraft, type HygieneProcedure } from '../../../pods/hygiene-preventive-draft/api';
import { hygieneTimestampLabel } from '../../../pods/hygiene-preventive-draft/labels';
import { assignmentListCarrier, assignmentListQuery, parseAssignmentListCoordinates } from '../../../pods/patient-assignment/list-coordinates';
import { actionHrefWithContext } from '../../../pods/kinesiology-evaluation/api';
import { actions, isInputError } from 'astro:actions';

Astro.response.headers.set('Cache-Control', 'no-store');
const UNAVAILABLE = 'El borrador no está disponible en este contexto de origen.';
// Presentation hint only: the backend checks the read grant on every request. Teachers never write.
const allowed = teacherGrant(Astro.cookies, 'hygiene-preventive-drafts:read');
const id = Astro.params.id ?? '';
let draft: HygieneDraft | null = null;
let error = '';
let consent: ConsentHistory | null = null;
let consentError = '';
let procedures: HygieneProcedure[] | null = null;
let procedureError = '';
// Approval copy (D5), page-side. The action owns the typed outcomes; these are the page's own states.
const APPROVAL_FORM_INPUT = 'Revisá los datos de la aprobación.';
const APPROVAL_UNCERTAIN = 'No se pudo confirmar la aprobación. Recargá la página y revisá el registro antes de volver a intentarlo.';
const loginRedirect = `/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
// The assignment choice and the list state of this page, carried through an approval so its redirect keeps them.
function pageCarriers(): [string, string][] {
 const carried: [string, string][] = [];
 const choices = Astro.url.searchParams.getAll('assignment_id');
 if (choices.length === 1 && /^[1-9]\d{0,18}$/.test(choices[0])) carried.push(['assignment_id', choices[0]]);
 if ([...Astro.url.searchParams.keys()].some((key) => key.startsWith('list_'))) {
  try {
   carried.push(...Object.entries(assignmentListCarrier(parseAssignmentListCoordinates(Astro.url.searchParams, true))));
  } catch {
   // An invalid list state is not carried; the detail keeps the origin context alone.
  }
 }
 return carried;
}
// Approval result (S5): success redirects with the origin context and approved=1 before any read.
const approvalResult = Astro.getActionResult(actions.approveHygieneProcedure);
const approvalData = approvalResult?.data;
if (approvalData?.success) {
 const returnParams = new URLSearchParams({ patient_id: approvalData.patient_id, subject_id: approvalData.subject_id, academic_group_id: approvalData.academic_group_id });
 for (const [key, value] of pageCarriers()) returnParams.set(key, value);
 returnParams.set('approved', '1');
 return Astro.redirect(`/teacher-clinical/hygiene-preventive/${encodeURIComponent(approvalData.id)}?${returnParams}`);
}
const approvalFailure = approvalData?.success === false ? approvalData : undefined;
let approvalError = approvalFailure?.error ?? '';
// An uncertain approval may have been stored: no approve form until a reload shows the entry as it is.
let approvalUncertain = approvalFailure?.uncertain ?? false;
if (approvalResult?.error) {
 approvalUncertain = !isInputError(approvalResult.error);
 approvalError = approvalUncertain ? APPROVAL_UNCERTAIN : APPROVAL_FORM_INPUT;
}
if (/sesión venció/i.test(approvalError)) return Astro.redirect(loginRedirect);
// Presentation hint only: the backend checks the approve grant on every request.
const canApprove = teacherGrant(Astro.cookies, 'hygiene-preventive-drafts:approve');

// Origin guard first: an invalid or foreign context never renders the draft.
let selected: ClinicalContext | null = null;
try { selected = parseClinicalContext(Astro.url.searchParams); } catch { selected = null; }
if (allowed) {
 if (!selected || !validId(id)) {
  error = UNAVAILABLE;
 } else {
  try {
   const loaded = await getHygieneDraft(id, Astro.cookies);
   if (loaded.patient_id === selected.patient_id && loaded.origin_subject_id === selected.subject_id && loaded.origin_group_id === selected.academic_group_id) draft = loaded;
   else error = UNAVAILABLE;
  } catch (failure) {
   if (failure instanceof ApiError && failure.status === 401) return Astro.redirect(`/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
   error = failure instanceof ApiError && failure.status === 404 ? UNAVAILABLE
    : failure instanceof ApiError && failure.status === 403 ? 'No tenés permiso vigente para consultar este borrador.'
    : 'No se pudo cargar el borrador en este contexto de origen.';
  }
 }
}
// Read after the draft and only for a loaded draft: a failure here replaces the consent section, never the draft.
if (draft) {
 try {
  consent = await getHygieneConsent(id, Astro.cookies);
 } catch (failure) {
  if (failure instanceof ApiError && failure.status === 401) return Astro.redirect(`/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
  consentError = 'No se pudo cargar el consentimiento. El borrador se muestra igual; intentá recargar la página.';
 }
 try {
  procedures = await listHygieneProcedures(id, Astro.cookies);
 } catch (failure) {
  if (failure instanceof ApiError && failure.status === 401) return Astro.redirect(`/auth/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
  procedureError = 'No se pudo cargar el registro de procedimientos. El borrador se muestra igual; intentá recargar la página.';
 }
}
// Approval controls (D5): only with the approve grant, for a loaded draft and log, and not after an uncertain outcome.
const approval = draft && procedures && canApprove && !approvalUncertain ? {
 href: actionHrefWithContext(actions.approveHygieneProcedure.toString(), { patient_id: draft.patient_id, subject_id: draft.origin_subject_id, academic_group_id: draft.origin_group_id }, Astro.url.href),
 carriers: [['id', draft.id], ['patient_id', draft.patient_id], ['subject_id', draft.origin_subject_id], ['academic_group_id', draft.origin_group_id], ...pageCarriers()] as [string, string][],
} : undefined;
const approvalHint = !!draft && !!procedures && !canApprove && procedures.some((item) => item.status === 'pending');
const approvedNotice = Astro.url.searchParams.get('approved') === '1';
// Back link keeps the list coordinates and the selected assignment, like the Oral Surgery detail.
let returnToList = '/teacher-clinical';
try {
 const returnParams = new URLSearchParams(assignmentListQuery(parseAssignmentListCoordinates(Astro.url.searchParams, true)));
 const choices = Astro.url.searchParams.getAll('assignment_id');
 if (choices.length === 1 && /^[1-9]\d{0,18}$/.test(choices[0])) returnParams.set('assignment_id', choices[0]);
 returnToList = `/teacher-clinical?${returnParams}`;
} catch {
 // An invalid list coordinate falls back to the first page of the teacher access.
}
---
<Layout>
 <main aria-labelledby="title">
  <a href={returnToList}>Volver al acceso clínico docente</a>
  <h1 id="title">Higiene y Preventiva II · consulta docente</h1>
  {!allowed ? <p role="alert">No tenés permiso para consultar este borrador como docente.</p>
  : error ? <p role="alert">{error}</p>
  : draft && <>
   <p>Consulta de solo lectura. Los docentes no editan borradores.</p>
   <p>Paciente: {draft.patient_id}<br />Asignatura de origen: {draft.origin_subject_id}<br />Grupo de origen: {draft.origin_group_id}</p>
   <p>Versión actual: {draft.version} · actualizado <time datetime={draft.updated_at}>{hygieneTimestampLabel(draft.updated_at)}</time></p>
   <section aria-labelledby="content-title">
    <h2 id="content-title">Contenido del borrador</h2>
    <HygieneReadOnly content={draft.content} />
   </section>
   <section aria-labelledby="consent-title">
    <h2 id="consent-title">Consentimiento en papel</h2>
    {consentError ? <p role="alert">{consentError}</p> : consent && <HygieneConsentHistory consent={consent} />}
   </section>
   <section aria-labelledby="procedures-title">
    <h2 id="procedures-title">Registro de procedimientos</h2>
    {approvedNotice && <p role="status">Procedimiento aprobado.</p>}
    {approvalError && <p role="alert">{approvalError}</p>}
    {procedureError ? <p role="alert">{procedureError}</p> : procedures && <>
     {approvalHint && <p role="status">Tu sesión no tiene permiso para aprobar procedimientos. Si el permiso se otorgó hace poco, cerrá sesión y volvé a ingresar.</p>}
     <HygieneProcedureLog procedures={procedures} approval={approval} />
    </>}
   </section>
  </>}
 </main>
 <script>
  // Each approval posts once: a second submit is ignored while the first is in flight (D5).
  for (const approvalForm of document.querySelectorAll<HTMLFormElement>('[data-approval-form]')) {
   approvalForm.addEventListener('submit', (event) => {
    if (approvalForm.dataset.submitting === 'true') {
     event.preventDefault();
     return;
    }
    approvalForm.dataset.submitting = 'true';
    const button = approvalForm.querySelector<HTMLButtonElement>('button');
    if (button) {
     button.disabled = true;
     button.textContent = 'Aprobando…';
    }
   });
  }
 </script>
</Layout>
<style>
 main { max-width: 58rem; margin: auto; padding: 1.5rem 0 3rem; overflow-wrap: anywhere; color: var(--ink); }
 section { margin: 1rem 0; padding: 1rem; background: var(--paper); border: 1px solid var(--line); border-radius: 0.65rem; }
 a { color: var(--rust-deep); text-decoration: underline; }
 [role="alert"] { border: 1px solid var(--rust-line); padding: 1rem; background: var(--rust-soft); border-radius: 0.65rem; }
</style>
