---
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.createTeacher);
---

{result?.data?.success ? (
	<div class="success">
		<p>Profesor creado: <strong>{result.data.teacher.nombres} {result.data.teacher.apellidos}</strong></p>
		<button type="button" onclick="this.closest('.success').nextElementSibling?.removeAttribute('hidden'); this.closest('.success').setAttribute('hidden', '')">Crear otro</button>
	</div>
) : null}

<form method="POST" action={actions.createTeacher} use:form hidden={result?.data?.success}>
	{result?.error && (
		<p class="error">{result.error.message}</p>
	)}

	<fieldset>
		<legend>Cuenta de acceso</legend>

		<label for="username">Usuario</label>
		<input type="text" id="username" name="username" required autocomplete="username" pattern="[A-Za-z0-9]+" />

		<label for="password">Contraseña</label>
		<input type="password" id="password" name="password" required minlength={10} autocomplete="new-password" />
		<p class="hint">Mínimo 10 caracteres, al menos una letra y un dígito</p>
	</fieldset>

	<fieldset>
		<legend>Datos del profesor</legend>

		<label for="nombres">Nombres</label>
		<input type="text" id="nombres" name="nombres" required />

		<label for="apellidos">Apellidos</label>
		<input type="text" id="apellidos" name="apellidos" required />

		<label for="email">Email (opcional)</label>
		<input type="email" id="email" name="email" autocomplete="email" />

		<label for="celular">Celular (opcional)</label>
		<input type="tel" id="celular" name="celular" />
	</fieldset>

	<button type="submit">Crear profesor</button>
</form>

<style>
	form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 400px;
		margin: 0 auto;
		padding: 2rem;
	}

	fieldset {
		border: 1px solid #e5e7eb;
		border-radius: 0.5rem;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	legend {
		font-weight: 600;
		font-size: 0.875rem;
		padding: 0 0.5rem;
	}

	label {
		font-weight: 500;
		font-size: 0.875rem;
	}

	input {
		padding: 0.5rem 0.75rem;
		border: 1px solid #d1d5db;
		border-radius: 0.375rem;
		font-size: 1rem;
	}

	button[type="submit"] {
		padding: 0.625rem 1rem;
		background: #2563eb;
		color: white;
		border: none;
		border-radius: 0.375rem;
		font-size: 1rem;
		cursor: pointer;
	}

	button[type="submit"]:hover {
		background: #1d4ed8;
	}

	.error {
		color: #dc2626;
		background: #fef2f2;
		padding: 0.5rem 0.75rem;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		margin: 0;
	}

	.hint {
		color: #6b7280;
		font-size: 0.75rem;
		margin: -0.5rem 0 0 0;
	}

	.success {
		text-align: center;
		max-width: 400px;
		margin: 0 auto 1rem;
		padding: 1rem;
		background: #f0fdf4;
		border-radius: 0.5rem;
	}

	.success p {
		color: #16a34a;
		font-size: 0.875rem;
		margin: 0 0 0.75rem;
	}

	.success button {
		padding: 0.5rem 1rem;
		background: transparent;
		color: #2563eb;
		border: 1px solid #2563eb;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		cursor: pointer;
	}
</style>
