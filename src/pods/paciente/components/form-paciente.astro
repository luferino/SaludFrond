---
import { actions } from 'astro:actions';

const today = new Date().toISOString().split('T')[0];
const result = Astro.getActionResult(actions.createPatient);
const errorMessage = result?.error?.message || result?.data?.error;
---

{result?.data?.success ? (
	<div class="success">
		<p role="status">Paciente registrado: <strong>{result.data.patient.nombres} {result.data.patient.apellidos}</strong> (Doc. {result.data.patient.documento})</p>
		<button type="button" onclick="this.closest('.success').nextElementSibling?.removeAttribute('hidden'); this.closest('.success').setAttribute('hidden', '')">Registrar otro</button>
	</div>
) : null}

<form method="POST" action={actions.createPatient} use:form hidden={result?.data?.success}>
	{errorMessage && (
		<p class="error" role="alert">{errorMessage}</p>
	)}

	<div class="form-heading">
		<p class="eyebrow">Ficha del paciente</p>
		<p>Todos los campos son obligatorios.</p>
	</div>

	<fieldset class="form-section">
		<legend>Datos personales</legend>
		<div class="field-grid">
			<div class="field">
				<label for="documento">N° de documento</label>
				<input type="text" id="documento" name="documento" required pattern="[0-9]{4,8}" aria-describedby="documento-hint" />
				<p class="hint" id="documento-hint">4 a 8 dígitos</p>
			</div>
			<div class="field">
				<label for="fecha_nacimiento">Fecha de nacimiento</label>
				<input type="text" id="fecha_nacimiento" name="fecha_nacimiento" required pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" placeholder="dd/mm/yyyy" maxlength="10" data-max={today} aria-describedby="fecha-nacimiento-hint" />
				<p class="hint" id="fecha-nacimiento-hint">dd/mm/yyyy (día/mes/año). No puede ser posterior a hoy.</p>
			</div>
			<div class="field">
				<label for="nombres">Nombres</label>
				<input type="text" id="nombres" name="nombres" required />
			</div>
			<div class="field">
				<label for="apellidos">Apellidos</label>
				<input type="text" id="apellidos" name="apellidos" required />
			</div>
			<fieldset class="sex-field full-width">
				<legend>Sexo</legend>
				<div class="radio-group">
					<label class="radio-label" for="sexo-m">
						<input type="radio" id="sexo-m" name="sexo" value="M" required />
						Masculino
					</label>
					<label class="radio-label" for="sexo-f">
						<input type="radio" id="sexo-f" name="sexo" value="F" required />
						Femenino
					</label>
				</div>
			</fieldset>
		</div>
	</fieldset>

	<fieldset class="form-section">
		<legend>Contacto</legend>
		<div class="field-grid">
			<div class="field">
				<label for="email">Email</label>
				<input type="email" id="email" name="email" required autocomplete="email" />
			</div>
			<div class="field">
				<label for="celular">Celular</label>
				<input type="tel" id="celular" name="celular" required />
			</div>
			<div class="field full-width">
				<label for="direccion">Dirección</label>
				<input type="text" id="direccion" name="direccion" required />
			</div>
		</div>
	</fieldset>

	<div class="form-footer">
		<p>Revisa los datos antes de registrar al paciente.</p>
		<button type="submit">Registrar paciente</button>
	</div>
</form>

<script>
	import { birthDateError, parseBirthDate } from '../birth-date';

	const birthDate = document.querySelector<HTMLInputElement>('#fecha_nacimiento');
	if (birthDate) {
		const validate = () => {
			const valid = !birthDate.value || parseBirthDate(birthDate.value, birthDate.dataset.max);
			birthDate.setCustomValidity(valid ? '' : birthDateError);
		};
		birthDate.addEventListener('input', validate);
		birthDate.addEventListener('change', validate);
		validate();
	}
</script>

<style>
	form {
		position: relative;
		display: grid;
		gap: 2rem;
		min-width: 0;
		margin-block-start: 3rem;
		padding: clamp(1.25rem, 3vw, 2.25rem);
		background: var(--paper);
		border: 1px solid var(--line);
		border-top: 5px solid #bac3b0;
		border-radius: 0 12px 12px 12px;
	}
	form::before {
		content: '';
		position: absolute;
		inset-block-start: calc(-1.5rem - 5px);
		inset-inline-start: -1px;
		width: min(45%, 14rem);
		height: 1.5rem;
		background: #bac3b0;
		border: 1px solid var(--line);
		border-bottom: 0;
		border-radius: 10px 18px 0 0;
		pointer-events: none;
	}
	[hidden] { display: none; }
	.form-heading p, .form-footer p { margin: 0; color: var(--muted); font-size: 0.8125rem; }
	.form-heading .eyebrow {
		margin-bottom: 0.4rem;
		color: var(--rust);
		font: 0.7rem/1.6 Consolas, monospace;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
	.form-section > legend { margin-bottom: 1.25rem; padding: 0; font: 1.5rem/1.3 var(--serif); }
	.form-section + .form-section { border-top: 1px solid var(--line); padding-top: 1.5rem; }
	.field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 1.5rem; }
	.field { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
	.full-width { grid-column: 1 / -1; }
	label, .sex-field legend { font-size: 0.875rem; font-weight: 600; }
	.sex-field legend { padding: 0; margin-bottom: 0.4rem; }
	input:not([type="radio"]) {
		width: 100%;
		min-width: 0;
		min-height: 46px;
		padding: 0.65rem 0.8rem;
		border: 1px solid #a49985;
		border-radius: 6px;
		background: #fffdf8;
		color: var(--ink);
		font: inherit;
		font-size: 1rem;
	}
	input:focus-visible, button:focus-visible { outline: 3px solid var(--rust); outline-offset: 3px; }
	.radio-group { display: flex; flex-wrap: wrap; gap: 0.75rem; }
	.radio-label {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 46px;
		padding: 0.6rem 1rem;
		border: 1px solid #a49985;
		border-radius: 6px;
		font-weight: 400;
		cursor: pointer;
	}
	.radio-label:has(:checked) { background: #e5eadf; border-color: #656f59; }
	input[type="radio"] { width: 1.1rem; height: 1.1rem; margin: 0; accent-color: var(--rust); }
	.hint { margin: 0; color: var(--muted); font-size: 0.75rem; }
	.form-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}
	button {
		min-height: 46px;
		padding: 0.75rem 1.25rem;
		border: 1px solid var(--rust);
		border-radius: 6px;
		background: var(--rust);
		color: var(--paper);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	button:hover { background: #843b28; }
	.error, .success { padding: 1.25rem; border: 1px solid var(--line); border-radius: 8px; overflow-wrap: anywhere; }
	.error { margin: 0; color: #843b28; background: #fae8df; border-color: #b97560; }
	.success { background: #e5eadf; border-color: #bac3b0; }
	.success p { margin: 0 0 1rem; }
	.success button { background: var(--paper); color: var(--rust); }
	.success button:hover { background: var(--canvas); }
	@media (max-width: 960px) {
		.field-grid { grid-template-columns: minmax(0, 1fr); }
	}
	@media (max-width: 480px) {
		.form-footer button { width: 100%; }
	}
</style>
