---
import { actions } from 'astro:actions';

const today = new Date().toISOString().split('T')[0];
const result = Astro.getActionResult(actions.createPatient);
---

{result?.data?.success ? (
	<div class="success">
		<p>Paciente registrado: <strong>{result.data.patient.nombres} {result.data.patient.apellidos}</strong> (Doc. {result.data.patient.documento})</p>
		<button type="button" onclick="this.closest('.success').nextElementSibling?.removeAttribute('hidden'); this.closest('.success').setAttribute('hidden', '')">Registrar otro</button>
	</div>
) : null}

<form method="POST" action={actions.createPatient} use:form hidden={result?.data?.success}>
	{result?.error && (
		<p class="error">{result.error.message}</p>
	)}

	<fieldset>
		<legend>Documento</legend>

		<label for="documento">N° de documento</label>
		<input type="text" id="documento" name="documento" required pattern="[0-9]{4,8}" />
		<p class="hint">4 a 8 dígitos</p>
	</fieldset>

	<fieldset>
		<legend>Datos personales</legend>

		<label for="nombres">Nombres</label>
		<input type="text" id="nombres" name="nombres" required />

		<label for="apellidos">Apellidos</label>
		<input type="text" id="apellidos" name="apellidos" required />

		<label for="fecha_nacimiento">Fecha de nacimiento</label>
		<input type="date" id="fecha_nacimiento" name="fecha_nacimiento" required max={today} />

		<label>Sexo</label>
		<div class="radio-group">
			<label class="radio-label">
				<input type="radio" name="sexo" value="M" required />
				Masculino
			</label>
			<label class="radio-label">
				<input type="radio" name="sexo" value="F" required />
				Femenino
			</label>
		</div>
	</fieldset>

	<fieldset>
		<legend>Contacto</legend>

		<label for="email">Email</label>
		<input type="email" id="email" name="email" required autocomplete="email" />

		<label for="celular">Celular</label>
		<input type="tel" id="celular" name="celular" required />

		<label for="direccion">Dirección</label>
		<input type="text" id="direccion" name="direccion" required />
	</fieldset>

	<button type="submit">Registrar paciente</button>
</form>

<style>
	form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 400px;
		margin: 0 auto;
		padding: 2rem;
	}

	fieldset {
		border: 1px solid #e5e7eb;
		border-radius: 0.5rem;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	legend {
		font-weight: 600;
		font-size: 0.875rem;
		padding: 0 0.5rem;
	}

	label {
		font-weight: 500;
		font-size: 0.875rem;
	}

	input[type="text"],
	input[type="email"],
	input[type="tel"],
	input[type="date"] {
		padding: 0.5rem 0.75rem;
		border: 1px solid #d1d5db;
		border-radius: 0.375rem;
		font-size: 1rem;
	}

	.radio-group {
		display: flex;
		gap: 1.5rem;
	}

	.radio-label {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-weight: 400;
		cursor: pointer;
	}

	button[type="submit"] {
		padding: 0.625rem 1rem;
		background: #2563eb;
		color: white;
		border: none;
		border-radius: 0.375rem;
		font-size: 1rem;
		cursor: pointer;
	}

	button[type="submit"]:hover {
		background: #1d4ed8;
	}

	.error {
		color: #dc2626;
		background: #fef2f2;
		padding: 0.5rem 0.75rem;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		margin: 0;
	}

	.hint {
		color: #6b7280;
		font-size: 0.75rem;
		margin: -0.5rem 0 0 0;
	}

	.success {
		text-align: center;
		max-width: 400px;
		margin: 0 auto 1rem;
		padding: 1rem;
		background: #f0fdf4;
		border-radius: 0.5rem;
	}

	.success p {
		color: #16a34a;
		font-size: 0.875rem;
		margin: 0 0 0.75rem;
	}

	.success button {
		padding: 0.5rem 1rem;
		background: transparent;
		color: #2563eb;
		border: 1px solid #2563eb;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		cursor: pointer;
	}
</style>
