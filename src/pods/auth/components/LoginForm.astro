---
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.login);
const returnTo = Astro.url.searchParams.get('returnTo') ?? '/';
---

<form method="POST" action={actions.login} use:form aria-labelledby="login-form-title" aria-describedby="login-required-hint">
	<input type="hidden" name="returnTo" value={returnTo} />

	{result?.error && (
		<p class="error" role="alert">{result.error.message}</p>
	)}

	<div class="form-heading">
		<p class="eyebrow">Credenciales</p>
		<p id="login-required-hint">Todos los campos son obligatorios.</p>
	</div>

	<fieldset>
		<legend id="login-form-title">Datos de acceso</legend>
		<div class="field">
			<label for="username">Usuario</label>
			<input type="text" id="username" name="username" required autocomplete="username" />
		</div>
		<div class="field">
			<label for="password">Contraseña</label>
			<input type="password" id="password" name="password" required autocomplete="current-password" />
		</div>
	</fieldset>

	<div class="form-footer">
		<a href="/auth/forgot-password" class="forgot-link">¿Olvidaste tu contraseña?</a>
		<button type="submit">Iniciar Sesión</button>
	</div>
</form>

<style>
	form {
		position: relative;
		display: grid;
		gap: 2rem;
		min-width: 0;
		margin-block-start: 3rem;
		padding: clamp(1.25rem, 3vw, 2.25rem);
		background: var(--paper);
		border: 1px solid var(--line);
		border-top: 5px solid var(--sage);
		border-radius: 0 12px 12px 12px;
	}
	form::before {
		content: '';
		position: absolute;
		inset-block-start: calc(-1.5rem - 5px);
		inset-inline-start: -1px;
		width: min(45%, 14rem);
		height: 1.5rem;
		background: var(--sage);
		border: 1px solid var(--line);
		border-bottom: 0;
		border-radius: 10px 18px 0 0;
		pointer-events: none;
	}
	.form-heading p, .form-footer p { margin: 0; color: var(--muted); font-size: 0.8125rem; }
	.form-heading .eyebrow {
		margin-bottom: 0.4rem;
		color: var(--rust);
		font: 0.7rem/1.6 Consolas, monospace;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	fieldset { display: grid; gap: 1.25rem; min-width: 0; margin: 0; padding: 0; border: 0; }
	legend { margin-bottom: 0.25rem; padding: 0; font: 1.5rem/1.3 var(--serif); }
	.field { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
	label { font-size: 0.875rem; font-weight: 600; }
	input {
		width: 100%;
		min-width: 0;
		min-height: 46px;
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--field-line);
		border-radius: 6px;
		background: var(--field);
		color: var(--ink);
		font: inherit;
		font-size: 1rem;
	}
	input:focus-visible, button:focus-visible { outline: 3px solid var(--rust); outline-offset: 3px; }
	.form-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}
	.forgot-link { color: var(--muted); font-size: 0.8125rem; text-decoration: underline; text-underline-offset: 4px; }
	button {
		min-height: 46px;
		padding: 0.75rem 1.25rem;
		border: 1px solid var(--rust);
		border-radius: 6px;
		background: var(--rust);
		color: var(--paper);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	button:hover { background: var(--rust-deep); }
	.error {
		margin: 0;
		padding: 1.25rem;
		border: 1px solid var(--rust-line);
		border-radius: 8px;
		overflow-wrap: anywhere;
		color: var(--rust-deep);
		background: var(--rust-soft);
		font-size: 0.875rem;
	}
	@media (max-width: 480px) {
		.form-footer { flex-direction: column-reverse; align-items: stretch; }
		.form-footer button { width: 100%; }
	}
</style>
