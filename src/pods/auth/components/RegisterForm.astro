---
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.register);
const errorMessage = result?.error?.message || result?.data?.error;
---

<form method="POST" action={actions.register} use:form aria-labelledby="register-form-title" aria-describedby="register-role-hint register-required-hint">
	{errorMessage && (
		<p class="error" role="alert">{errorMessage}</p>
	)}
	{result?.data?.success && (
		<p class="success" role="status">Usuario registrado correctamente. Su sesión permanece activa.</p>
	)}
	<div class="form-heading">
		<p class="eyebrow">Nueva cuenta</p>
		<p id="register-role-hint">La nueva cuenta tendrá el rol de estudiante.</p>
		<p id="register-required-hint">Todos los campos son obligatorios.</p>
	</div>

	<fieldset>
		<legend id="register-form-title">Datos de acceso</legend>
		<div class="field-grid">
			<div class="field">
				<label for="username">Usuario</label>
				<input type="text" id="username" name="username" required autocomplete="username" />
			</div>
			<div class="field">
				<label for="email">Email</label>
				<input type="email" id="email" name="email" required autocomplete="email" />
			</div>
			<div class="field full-width">
				<label for="password">Contraseña</label>
				<input type="password" id="password" name="password" required autocomplete="new-password" />
			</div>
		</div>
	</fieldset>

	<div class="form-footer">
		<p>Revisa los datos antes de registrar la cuenta.</p>
		<button type="submit">Registrar usuario</button>
	</div>
</form>

<style>
	form {
		position: relative;
		display: grid;
		gap: 2rem;
		min-width: 0;
		margin-block-start: 3rem;
		padding: clamp(1.25rem, 3vw, 2.25rem);
		background: var(--paper);
		border: 1px solid var(--line);
		border-top: 5px solid #bac3b0;
		border-radius: 0 12px 12px 12px;
	}
	form::before {
		content: '';
		position: absolute;
		inset-block-start: calc(-1.5rem - 5px);
		inset-inline-start: -1px;
		width: min(45%, 14rem);
		height: 1.5rem;
		background: #bac3b0;
		border: 1px solid var(--line);
		border-bottom: 0;
		border-radius: 10px 18px 0 0;
		pointer-events: none;
	}
	.form-heading p, .form-footer p { margin: 0; color: var(--muted); font-size: 0.8125rem; }
	.form-heading .eyebrow {
		margin-bottom: 0.4rem;
		color: var(--rust);
		font: 0.7rem/1.6 Consolas, monospace;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
	legend { margin-bottom: 1.25rem; padding: 0; font: 1.5rem/1.3 var(--serif); }
	.field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 1.5rem; }
	.field { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
	.full-width { grid-column: 1 / -1; }
	label { font-size: 0.875rem; font-weight: 600; }
	input {
		width: 100%;
		min-width: 0;
		min-height: 46px;
		padding: 0.65rem 0.8rem;
		border: 1px solid #a49985;
		border-radius: 6px;
		background: #fffdf8;
		color: var(--ink);
		font: inherit;
		font-size: 1rem;
	}
	input:focus-visible, button:focus-visible { outline: 3px solid var(--rust); outline-offset: 3px; }
	.form-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}
	button {
		min-height: 46px;
		padding: 0.75rem 1.25rem;
		border: 1px solid var(--rust);
		border-radius: 6px;
		background: var(--rust);
		color: var(--paper);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	button:hover { background: #843b28; }
	.error, .success {
		margin: 0;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		overflow-wrap: anywhere;
		font-size: 0.875rem;
	}
	.error { color: #843b28; background: #fae8df; border-color: #b97560; }
	.success { color: var(--ink); background: #e5eadf; border-color: #bac3b0; }
	@media (max-width: 960px) {
		.field-grid { grid-template-columns: minmax(0, 1fr); }
	}
	@media (max-width: 480px) {
		.form-footer button { width: 100%; }
	}
</style>
