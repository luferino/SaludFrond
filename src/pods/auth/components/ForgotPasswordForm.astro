---
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.forgotPassword);
---

{result?.data?.success ? (
	<div class="success">
		<p>{result.data.message}</p>
		<a href="/auth/login">Volver al login</a>
	</div>
) : (
	<form method="POST" action={actions.forgotPassword} use:form>
		{result?.error && (
			<p class="error">{result.error.message}</p>
		)}

		<label for="username">Usuario</label>
		<input type="text" id="username" name="username" required autocomplete="username" />

		<button type="submit">Enviar enlace de recuperación</button>
	</form>
)}

<style>
	form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 320px;
		margin: 0 auto;
		padding: 2rem;
	}

	label {
		font-weight: 500;
		font-size: 0.875rem;
	}

	input {
		padding: 0.5rem 0.75rem;
		border: 1px solid #d1d5db;
		border-radius: 0.375rem;
		font-size: 1rem;
	}

	button {
		padding: 0.625rem 1rem;
		background: #2563eb;
		color: white;
		border: none;
		border-radius: 0.375rem;
		font-size: 1rem;
		cursor: pointer;
	}

	button:hover {
		background: #1d4ed8;
	}

	.error {
		color: #dc2626;
		background: #fef2f2;
		padding: 0.5rem 0.75rem;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		margin: 0;
	}

	.success {
		text-align: center;
		max-width: 320px;
		margin: 0 auto;
		padding: 2rem;
	}

	.success p {
		color: #16a34a;
		background: #f0fdf4;
		padding: 0.75rem 1rem;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		margin-bottom: 1rem;
	}

	.success a {
		color: #2563eb;
		font-size: 0.875rem;
	}
</style>
