---
import type { SubjectGroupAssociation } from '../api';

interface Props {
	state: 'success' | 'denied' | 'failed' | 'invalid-pagination' | 'invalid-filter';
	items: SubjectGroupAssociation[];
	limit: number;
	offset: number;
	subjectId: string | null;
	filterHref: string;
	clearFilterHref: string;
	previousHref: string | null;
	nextHref: string | null;
	invalidMessage: string;
}

const { state, items, limit, offset, subjectId, filterHref, clearFilterHref, previousHref, nextHref, invalidMessage } = Astro.props;
---

<section class="filter-panel" aria-labelledby="filter-title">
	<h2 id="filter-title">Filtrar por asignatura</h2>
	<form action="/subject-groups" method="get">
		<input type="hidden" name="limit" value={limit} />
		<label for="subject-id">UUID de asignatura</label>
		<input
			id="subject-id"
			name="subject_id"
			type="text"
			required
			value={subjectId ?? ''}
			aria-describedby="subject-id-help"
			autocomplete="off"
			spellcheck="false"
		/>
		<p id="subject-id-help">Ingresá el UUID completo de la asignatura para aplicar el filtro.</p>
		<div class="filter-actions">
			<button type="submit">Aplicar filtro</button>
			<a href={clearFilterHref}>Limpiar filtro</a>
		</div>
	</form>
</section>

{state === 'denied' ? (
	<section class="message denied" role="status" aria-labelledby="state-title">
		<h2 id="state-title">Sin permiso para consultar</h2>
		<p>Tu sesión no tiene acceso de lectura a las asociaciones entre asignaturas y grupos.</p>
	</section>
) : state === 'failed' ? (
	<section class="message error" role="alert" aria-labelledby="state-title">
		<h2 id="state-title">No se pudieron cargar las asociaciones</h2>
		<p>Ocurrió un problema al consultar esta página. Probá de nuevo más tarde.</p>
	</section>
) : state === 'invalid-pagination' ? (
	<section class="message error" role="alert" aria-labelledby="state-title">
		<h2 id="state-title">Paginación no válida</h2>
		<p>{invalidMessage}</p>
		<a href="/subject-groups">Volver a la primera página</a>
	</section>
) : state === 'invalid-filter' ? (
	<section class="message error" role="alert" aria-labelledby="state-title">
		<h2 id="state-title">Filtro de asignatura no válido</h2>
		<p>{invalidMessage}</p>
		<a href={clearFilterHref}>Limpiar filtro</a>
	</section>
) : items.length === 0 ? (
	<section class="message empty" role="status" aria-labelledby="state-title">
		<h2 id="state-title">No hay asociaciones en esta página</h2>
		<p>{subjectId
			? 'La consulta filtrada no devolvió asociaciones para esta página.'
			: 'La consulta no devolvió asociaciones para esta página.'}</p>
	</section>
) : (
	<section class="catalog" aria-label="Asociaciones entre asignaturas y grupos académicos">
		<ul class="association-list">
			{items.map((association) => (
				<li class="association">
					<div class="identifier">
						<span class="field-label">Asignatura</span>
					<code>{association.subject_id}</code>
					</div>
					<div class="identifier">
						<span class="field-label">Grupo académico</span>
						<code>{association.academic_group_id}</code>
					</div>
				</li>
			))}
		</ul>
	</section>
)}

{state === 'success' && (previousHref !== null || nextHref !== null) && (
	<nav class="pagination" aria-label="Paginación de asociaciones académicas">
		{previousHref !== null
			? <a href={previousHref} rel="prev">Página anterior</a>
			: <span aria-disabled="true">Página anterior</span>}
		{nextHref !== null
			? <a href={nextHref} rel="next">Página siguiente</a>
			: <span aria-disabled="true">Página siguiente</span>}
	</nav>
)}

<style>
	.filter-panel {
		padding: 1.25rem clamp(1rem, 3vw, 1.5rem);
		border-inline-start: 5px solid var(--rust);
		border-radius: 0 8px 8px 0;
		background: var(--paper);
	}
	.filter-panel h2 { margin: 0 0 1rem; font: 1.35rem/1.3 var(--serif); }
	.filter-panel form { display: grid; gap: 0.6rem; max-width: 42rem; }
	.filter-panel label, .field-label { font-weight: 600; }
	.filter-panel input {
		width: 100%;
		min-width: 0;
		padding: 0.75rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--field);
		color: var(--ink);
		font: 1rem/1.4 Consolas, monospace;
	}
	.filter-panel input:focus-visible, .filter-actions a:focus-visible, .filter-actions button:focus-visible,
	.pagination a:focus-visible, .message a:focus-visible { outline: 3px solid var(--sage-deep); outline-offset: 3px; }
	.filter-panel p { margin: 0; color: var(--muted); }
	.filter-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 0.25rem; }
	.filter-actions button {
		padding: 0.7rem 1rem;
		border: 0;
		border-radius: 6px;
		background: var(--rust);
		color: var(--field);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.filter-actions button:hover { background: var(--rust-deep); }
	.filter-actions a, .message a { text-decoration: underline; text-underline-offset: 4px; }
	.catalog {
		position: relative;
		margin-block-start: 3rem;
		padding: 1.5rem clamp(1rem, 3vw, 2rem);
		border-top: 5px solid var(--sage);
		border-radius: 0 12px 12px 12px;
		background: var(--paper);
	}
	.catalog::before {
		content: '';
		position: absolute;
		inset-inline-start: -1px;
		inset-block-start: calc(-1.5rem - 5px);
		width: min(45%, 14rem);
		height: 1.5rem;
		border-radius: 8px 8px 0 0;
		background: var(--sage);
		pointer-events: none;
	}
	.association-list { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
	.association {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		min-width: 0;
		padding: 1rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--field);
	}
	.identifier { display: grid; gap: 0.35rem; min-width: 0; }
	.identifier code { min-width: 0; color: var(--ink); font: 0.9rem/1.5 Consolas, monospace; overflow-wrap: anywhere; }
	.field-label { color: var(--muted); font-size: 0.9rem; }
	.message {
		margin-block-start: 2rem;
		padding: 1.25rem 1.5rem;
		border-inline-start: 5px solid var(--sage-deep);
		border-radius: 0 8px 8px 0;
		background: var(--paper);
	}
	.message h2 { margin: 0; font: 1.35rem/1.3 var(--serif); }
	.message p { margin: 0.65rem 0 0; color: var(--muted); }
	.message a { display: inline-block; margin-block-start: 0.75rem; }
	.denied, .error { border-inline-start-color: var(--rust); }
	.pagination { display: flex; justify-content: space-between; gap: 1rem; margin-block-start: 1.5rem; }
	.pagination a, .pagination span { padding: 0.6rem 0.9rem; border-radius: 6px; }
	.pagination a { background: var(--rust); color: var(--field); }
	.pagination a:hover { background: var(--rust-deep); }
	.pagination span { color: var(--muted); }
	@media (max-width: 600px) {
		.association { grid-template-columns: minmax(0, 1fr); }
		.pagination { align-items: stretch; flex-direction: column; }
		.pagination a, .pagination span { text-align: center; }
	}
</style>
