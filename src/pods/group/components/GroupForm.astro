---
import { actions, isInputError } from 'astro:actions';

interface CreatedGroup {
	id: string;
	academic_year: number;
	curriculum_semester: number;
	name: string;
	created_by: string | null;
	created_at: string;
}

interface Props {
	result?: {
		data?: { success?: boolean; group?: CreatedGroup; error?: string };
		error?: { message?: string; fields?: Record<string, string[]> };
	};
}

const { result } = Astro.props;
const success = result?.data?.success ? result.data.group : undefined;
const frameworkError = result?.error?.message;
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : {};
const feedback = frameworkError ?? result?.data?.error;
---

<section class="group-form" aria-labelledby="group-form-title">
	<p class="eyebrow">Nuevo grupo</p>
	<h2 id="group-form-title">Crear grupo académico</h2>
	{success && (
		<p class="success" role="status">
			Grupo creado: <strong>{success.name}</strong> (año {success.academic_year}, semestre {success.curriculum_semester}).
			<span class="identity">ID: {success.id}</span>
		</p>
	)}
	{feedback && <p class="error" role="alert">{feedback}</p>}
	<form method="POST" action={actions.createGroup}>
		<div class="field">
			<label for="group-academic-year">Año académico</label>
			<input
				type="number"
				id="group-academic-year"
				name="academic_year"
				min="1"
				max="2147483647"
				step="1"
				required
				aria-describedby="group-academic-year-hint"
			/>
			<p class="hint" id="group-academic-year-hint">Usá un número entero entre 1 y 2147483647.</p>
			{fieldErrors.academic_year && <p class="error" role="alert">{fieldErrors.academic_year.join(', ')}</p>}
		</div>
		<div class="field">
			<label for="group-curriculum-semester">Semestre curricular</label>
			<input
				type="number"
				id="group-curriculum-semester"
				name="curriculum_semester"
				min="1"
				max="2147483647"
				step="1"
				required
				aria-describedby="group-curriculum-semester-hint"
			/>
			<p class="hint" id="group-curriculum-semester-hint">No hay un máximo de semestres curriculares.</p>
			{fieldErrors.curriculum_semester && <p class="error" role="alert">{fieldErrors.curriculum_semester.join(', ')}</p>}
		</div>
		<div class="field">
			<label for="group-name">Nombre</label>
			<input
				type="text"
				id="group-name"
				name="name"
				required
				autocomplete="off"
				aria-describedby="group-name-hint"
			/>
			<p class="hint" id="group-name-hint">Ingresá el nombre del grupo; se conserva el uso de mayúsculas.</p>
			{fieldErrors.name && <p class="error" role="alert">{fieldErrors.name.join(', ')}</p>}
		</div>
		<button type="submit">Crear grupo</button>
	</form>
</section>

<style>
	.group-form {
		position: relative;
		min-width: 0;
		padding: clamp(1.25rem, 3vw, 2rem);
		border: 1px solid var(--line);
		border-top: 5px solid var(--sage);
		border-radius: 0 12px 12px 12px;
		background: var(--paper);
	}
	.eyebrow { margin: 0 0 0.4rem; color: var(--rust); font: 0.7rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	h2 { margin: 0 0 1.25rem; font: 1.5rem/1.3 var(--serif); }
	form { display: grid; gap: 1.25rem; }
	.field { display: grid; gap: 0.4rem; min-width: 0; }
	label { font-size: 0.875rem; font-weight: 600; }
	input {
		width: 100%;
		min-width: 0;
		min-height: 46px;
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--field-line);
		border-radius: 6px;
		background: var(--field);
		color: var(--ink);
		font: inherit;
	}
	input:focus-visible, button:focus-visible { outline: 3px solid var(--rust); outline-offset: 3px; }
	.hint { margin: 0; color: var(--muted); font-size: 0.75rem; }
	button {
		min-height: 46px;
		justify-self: start;
		padding: 0.75rem 1.25rem;
		border: 1px solid var(--rust);
		border-radius: 6px;
		background: var(--rust);
		color: var(--paper);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	button:hover { background: var(--rust-deep); }
	.success, .error { margin: 0 0 1rem; padding: 1rem; border: 1px solid var(--line); border-radius: 8px; overflow-wrap: anywhere; }
	.success { background: var(--sage-soft); border-color: var(--sage); }
	.error { color: var(--rust-deep); background: var(--rust-soft); border-color: var(--rust-line); }
	.identity { display: block; font-size: 0.8rem; }
	@media (max-width: 480px) { button { width: 100%; } }
</style>
