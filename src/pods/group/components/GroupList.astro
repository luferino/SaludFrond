---
import type { GroupSummary } from '../api';

interface Props {
	state: 'success' | 'denied' | 'failed' | 'invalid-pagination';
	items: GroupSummary[];
	limit: number;
	previousOffset: number | null;
	nextOffset: number | null;
	invalidMessage: string;
}

const { state, items, limit, previousOffset, nextOffset, invalidMessage } = Astro.props;
const pageHref = (next: number) => `/groups?${new URLSearchParams({
	limit: String(limit),
	offset: String(next),
})}`;
---

{state === 'denied' ? (
	<section class="message denied" role="status" aria-labelledby="groups-state-title">
		<h2 id="groups-state-title">Sin permiso para consultar</h2>
		<p>Tu sesión no tiene acceso de lectura al catálogo de grupos académicos.</p>
	</section>
) : state === 'failed' ? (
	<section class="message error" role="alert" aria-labelledby="groups-state-title">
		<h2 id="groups-state-title">No se pudo cargar el catálogo</h2>
		<p>Ocurrió un problema al consultar los grupos académicos. Probá de nuevo más tarde.</p>
	</section>
) : state === 'invalid-pagination' ? (
	<section class="message error" role="alert" aria-labelledby="groups-state-title">
		<h2 id="groups-state-title">Paginación no válida</h2>
		<p>{invalidMessage}</p>
		<a href="/groups">Volver al inicio del catálogo</a>
	</section>
) : items.length === 0 ? (
	<section class="message empty" role="status" aria-labelledby="groups-state-title">
		<h2 id="groups-state-title">No hay grupos académicos en esta página</h2>
		<p>La consulta no devolvió grupos para esta página.</p>
	</section>
) : (
	<section class="catalog" aria-label="Listado de grupos académicos">
		<ul class="group-list">
			{items.map((group) => (
				<li class="group" data-group-id={group.id}>
					<dl class="group-details">
						<div><dt>Año académico</dt><dd>{group.academic_year}</dd></div>
						<div><dt>Semestre curricular</dt><dd>{group.curriculum_semester}</dd></div>
						<div class="name"><dt>Nombre</dt><dd>{group.name}</dd></div>
					</dl>
				</li>
			))}
		</ul>
	</section>
)}

{state === 'success' && (previousOffset !== null || nextOffset !== null) && (
	<nav class="pagination" aria-label="Paginación de grupos académicos">
		{previousOffset !== null
			? <a href={pageHref(previousOffset)} rel="prev">Página anterior</a>
			: <span aria-disabled="true">Página anterior</span>}
		{nextOffset !== null
			? <a href={pageHref(nextOffset)} rel="next">Página siguiente</a>
			: <span aria-disabled="true">Página siguiente</span>}
	</nav>
)}

<style>
	.catalog {
		position: relative;
		margin-block-start: 3rem;
		padding: 1.5rem clamp(1rem, 3vw, 2rem);
		border-top: 5px solid var(--sage);
		border-radius: 0 12px 12px 12px;
		background: var(--paper);
	}
	.catalog::before {
		content: '';
		position: absolute;
		inset-inline-start: -1px;
		inset-block-start: calc(-1.5rem - 5px);
		width: min(45%, 14rem);
		height: 1.5rem;
		border-radius: 8px 8px 0 0;
		background: var(--sage);
		pointer-events: none;
	}
	.group-list { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
	.group {
		min-width: 0;
		padding: 1rem 1.1rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--field);
	}
	.group-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem 1.5rem; margin: 0; }
	.group-details div { min-width: 0; }
	.group-details dt { color: var(--muted); font-size: 0.8rem; }
	.group-details dd { margin: 0.2rem 0 0; overflow-wrap: anywhere; }
	.group-details .name { grid-column: 1 / -1; }
	.group-details .name dd { font-weight: 600; }
	.message {
		margin-block-start: 3rem;
		padding: 1.25rem 1.5rem;
		border-inline-start: 5px solid var(--sage-deep);
		border-radius: 0 8px 8px 0;
		background: var(--paper);
	}
	.message h2 { margin: 0; font: 1.35rem/1.3 var(--serif); }
	.message p { margin: 0.65rem 0 0; color: var(--muted); }
	.message a { display: inline-block; margin-block-start: 0.75rem; text-decoration: underline; text-underline-offset: 4px; }
	.denied, .error { border-inline-start-color: var(--rust); }
	.pagination { display: flex; justify-content: space-between; gap: 1rem; margin-block-start: 1.5rem; }
	.pagination a, .pagination span { padding: 0.6rem 0.9rem; border-radius: 6px; }
	.pagination a { background: var(--rust); color: var(--field); }
	.pagination a:hover { background: var(--rust-deep); }
	.pagination span { color: var(--muted); }
	@media (max-width: 480px) {
		.group-details { grid-template-columns: minmax(0, 1fr); }
		.group-details .name { grid-column: auto; }
		.pagination { align-items: stretch; flex-direction: column; }
		.pagination a, .pagination span { text-align: center; }
	}
</style>
