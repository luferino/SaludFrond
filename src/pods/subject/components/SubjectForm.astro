---
import { actions } from 'astro:actions';

interface Props {
	result?: {
		data?: {
			success?: boolean;
			subject?: { id: string; name: string };
			error?: string;
		};
		error?: { message: string };
	};
}

const { result } = Astro.props;
const success = result?.data?.success ? result.data.subject : undefined;
const feedback = result?.error?.message ?? result?.data?.error;
---

<section class="subject-form" aria-labelledby="subject-form-title">
	<p class="eyebrow">Nueva asignatura</p>
	<h2 id="subject-form-title">Crear asignatura</h2>
	{success && (
		<p class="success" role="status">
			Asignatura creada: <strong>{success.name}</strong> <span class="identity">(ID: {success.id})</span>
		</p>
	)}
	{feedback && <p class="error" role="alert">{feedback}</p>}
	<form method="POST" action={actions.createSubject} aria-describedby="subject-name-hint">
		<div class="field">
			<label for="subject-name">Nombre</label>
			<input
				type="text"
				id="subject-name"
				name="name"
				required
				aria-describedby="subject-name-hint"
				autocomplete="off"
			/>
			<p class="hint" id="subject-name-hint">Ingresá el nombre de la asignatura. Se permiten nombres repetidos.</p>
		</div>
		<button type="submit">Crear asignatura</button>
	</form>
</section>

<style>
	.subject-form {
		position: relative;
		min-width: 0;
		padding: clamp(1.25rem, 3vw, 2rem);
		border: 1px solid var(--line);
		border-top: 5px solid var(--sage);
		border-radius: 0 12px 12px 12px;
		background: var(--paper);
	}
	.eyebrow { margin: 0 0 0.4rem; color: var(--rust); font: 0.7rem/1.6 Consolas, monospace; letter-spacing: 0.1em; text-transform: uppercase; }
	h2 { margin: 0 0 1.25rem; font: 1.5rem/1.3 var(--serif); }
	form { display: grid; gap: 1.25rem; }
	.field { display: grid; gap: 0.4rem; min-width: 0; }
	label { font-size: 0.875rem; font-weight: 600; }
	input {
		width: 100%;
		min-width: 0;
		min-height: 46px;
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--field-line);
		border-radius: 6px;
		background: var(--field);
		color: var(--ink);
		font: inherit;
	}
	input:focus-visible, button:focus-visible { outline: 3px solid var(--rust); outline-offset: 3px; }
	.hint { margin: 0; color: var(--muted); font-size: 0.75rem; }
	button {
		min-height: 46px;
		justify-self: start;
		padding: 0.75rem 1.25rem;
		border: 1px solid var(--rust);
		border-radius: 6px;
		background: var(--rust);
		color: var(--paper);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	button:hover { background: var(--rust-deep); }
	.success, .error { margin: 0 0 1rem; padding: 1rem; border: 1px solid var(--line); border-radius: 8px; overflow-wrap: anywhere; }
	.success { background: var(--sage-soft); border-color: var(--sage); }
	.error { color: var(--rust-deep); background: var(--rust-soft); border-color: var(--rust-line); }
	.identity { font-size: 0.8rem; }
	@media (max-width: 480px) { button { width: 100%; } }
</style>
