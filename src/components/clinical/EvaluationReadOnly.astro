---
import type { Evaluation } from '../../pods/kinesiology-evaluation/api';
interface Props { evaluation: Evaluation }
const { evaluation } = Astro.props;
const content = evaluation.content;
const fields = [
 ['admission_date', 'Fecha de ingreso'], ['admission_status', 'Estado al ingreso'],
 ['occupation', 'Ocupación'], ['referring_physician', 'Profesional que deriva'],
 ['illness_history', 'Historia de la enfermedad'], ['medical_diagnosis', 'Diagnóstico médico'],
 ['kinesiology_diagnosis', 'Diagnóstico kinésico'], ['objectives', 'Objetivos'], ['proposed_treatment', 'Tratamiento propuesto'],
] as const;
const antecedents = { hta: 'Hipertensión arterial', dbt: 'Diabetes', diu: 'Dispositivo intrauterino', sedentary_lifestyle: 'Sedentarismo', pacemaker: 'Marcapasos', other: 'Otros antecedentes' };
---
<section aria-labelledby="clinical-content">
 <h2 id="clinical-content">Contenido clínico · solo lectura</h2>
 <p>Estado: {evaluation.status === 'draft' ? 'Borrador' : evaluation.status === 'submitted' ? 'Enviada' : 'Validada'}</p>
 {evaluation.patient ? <p>Paciente: {evaluation.patient.apellidos}, {evaluation.patient.nombres} · Documento: {evaluation.patient.documento}</p> : <p>Datos del paciente no disponibles.</p>}
 {evaluation.age !== null && <p>Edad: {evaluation.age}</p>}
 <dl>
  {fields.map(([key, label]) => <div><dt>{label}</dt><dd>{content[key] ?? 'Sin registrar'}</dd></div>)}
  {Object.entries(antecedents).map(([key, label]) => {
   const value = content.antecedents?.[key as keyof typeof antecedents];
   return <div><dt>{label}</dt><dd>{value === undefined ? 'Sin registrar' : value === null ? 'Sin determinar' : value === true ? 'Sí' : value === false ? 'No' : value}</dd></div>;
  })}
 </dl>
 <h3>Estudios complementarios</h3>
 {content.studies?.length ? <ul>{content.studies.map((study) => <li><strong>{study.type}</strong><p>{study.description}</p><p>{study.date ?? 'Fecha sin registrar'}</p></li>)}</ul> : <p>Sin estudios registrados.</p>}
</section>
<style>
 section { margin: 1rem 0; padding: 1rem; border: 1px solid var(--line); background: var(--paper); border-radius: .65rem; }
 dl > div { margin: .75rem 0; } dt { font-weight: 700; } dd { margin: .25rem 0; white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
